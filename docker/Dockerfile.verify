# syntax=docker/dockerfile:1

# A throwaway image for running the test suite on Linux. It is not the product image (that is
# the `Dockerfile` at the repository root, which only builds `sbrs`). This one holds the Rust
# toolchain and Debian's Chromium with its driver. (The BoringSSL build tools of the stealth
# layer belong to https://github.com/MustCodeAl/seleniumbase-rs-stealth now.)
#
# Build it with `docker build -f docker/Dockerfile.verify -t seleniumbase-rs:verify-tools .`
# and run the suites with `docker/verify-linux.sh`, which says how. Remove it with
# `docker rmi seleniumbase-rs:verify-tools` when you are done.
FROM rust:1.99-bookworm

# chromium and chromium-driver: the real-browser tests. ca-certificates: the registry downloads.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# clippy and rustfmt: the official image carries neither, and the lint and format checks of the
# gate (`cargo clippy ... -D warnings`, `cargo fmt --all -- --check`) run in it too.
RUN rustup component add clippy rustfmt

# xvfb and xauth: a virtual display for the few tests that need a headed browser. Run those
# with `-e SBRS_XVFB=1` (see docker/verify-linux.sh).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xauth \
    && rm -rf /var/lib/apt/lists/*

# The sources are mounted read-only at /src and copied to /work by the helper script. The
# build output goes to a named volume at /target, so it survives between runs.
#
# CI: the real-browser tests pass `--no-sandbox` when `CI` is set (Chromium cannot start its
# sandbox as root in a container); SB_NO_SANDBOX does the same for code that builds its own
# launch options.
ENV CARGO_TARGET_DIR=/target \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_TERM_COLOR=never \
    CI=true \
    SB_HEADLESS=true \
    SB_NO_SANDBOX=1

COPY docker/verify-linux.sh /usr/local/bin/verify-linux
ENTRYPOINT ["/usr/local/bin/verify-linux"]
CMD ["cargo", "--version"]
