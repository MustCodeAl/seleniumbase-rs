cmd smooth-scroll-to help_heading="Page commands" help="Smoothly scroll an element into view." {
    flag --css help="CSS selector for the target element" required=#true {
        arg <CSS>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs --url https://example.com smooth-scroll-to --css footer"
}
cmd uc-click help_heading="Page commands" help="Perform a UC-mode click on an element." {
    flag --css help="CSS selector for the target element" required=#true {
        arg <CSS>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs --uc --url https://example.com uc-click --css a"
}
cmd uc-type help_heading="Page commands" help="Perform UC-mode typing into an element." {
    flag --css help="CSS selector for the target element" required=#true {
