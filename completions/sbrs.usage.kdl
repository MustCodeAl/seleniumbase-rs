    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs --url https://example.com human-type --css '#q' --text hello"
}
cmd human-click help_heading="Page commands" help="Click an element with human-like timing and noise." {
    flag --css help="CSS selector for the target element" required=#true {
