        arg <CACHE_DIR>
    }
}
cmd encrypt help="Encrypt text with a passphrase (AES-256-GCM); read from stdin if TEXT is omitted" {
    alias obfuscate
    long_help #"""
Encrypt text with a passphrase (AES-256-GCM); read from stdin if TEXT is omitted.

The passphrase comes from the SB_ENCRYPTION_KEY environment variable, never from an argument, so it stays out of shell history and process listings. Python's `sbrs obfuscate` is the same command.
"""#
    arg "[TEXT]" help="The text to encrypt" required=#false
}
cmd decrypt help="Decrypt a token made by `sbrs encrypt`; read from stdin if TOKEN is omitted. Python's `sbrs unobfuscate` is the same command" {
    alias unobfuscate
    arg "[TOKEN]" help="The token to decrypt" required=#false
}
