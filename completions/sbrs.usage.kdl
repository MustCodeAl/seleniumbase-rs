cmd export-recording help_heading="Record and replay" help="Turn an action file written by `record` into a Rust test." {
    flag "-o --output" help="Rust test to write (default: the action file's name with .rs)" {
        arg <OUTPUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Action file written by `sbrs record` (.json or .yaml)"
    example "sbrs export-recording actions.json --output tests/login.rs"
}
cmd patch-chromedriver help_heading="Drivers, grid and servers" help="Patch a chromedriver binary to reduce detection surface." {
    flag --path help="Path to the chromedriver binary" required=#true {
        arg <PATH>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs patch-chromedriver --path ./chromedriver"
}
cmd patch-chrome help_heading="Drivers, grid and servers" help="Patch a Chrome/Chromium binary for native-level spoofing." {
    flag --path help="Path to the Chrome/Chromium binary" required=#true {
        arg <PATH>
    }
    flag --cache-dir help="Directory where patched binaries are cached" {
        arg <CACHE_DIR>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs patch-chrome --path ./chrome --cache-dir ./patched"
}
cmd encrypt help_heading=Security help="Encrypt text with a passphrase (AES-256-GCM); read from stdin if TEXT is omitted." {
    alias obfuscate
    long_help #"""
Encrypt text with a passphrase (AES-256-GCM); read from stdin if TEXT is omitted.

The passphrase comes from the SB_ENCRYPTION_KEY environment variable, never from an argument, so it stays out of shell history and process listings. Python's `sbrs obfuscate` is the same command.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[TEXT]" help="The text to encrypt."
    example "sbrs encrypt 'my secret'"
}
cmd decrypt help_heading=Security help="Decrypt a token made by `sbrs encrypt`; read from stdin if TOKEN is omitted. Python's `sbrs unobfuscate` is the same command." {
    alias unobfuscate
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[TOKEN]" help="The token to decrypt."
    example "sbrs decrypt TOKEN"
}
cmd doctor help_heading="Info and setup" help="Run a diagnostic check on the environment and configuration." {
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs doctor"
}
cmd prompt help_heading="Info and setup" help="Print one short line for a shell prompt: the installed Chrome's major version and whether a matching chromedriver is at hand." args_override_self=#false {
    long_help #"""
Print one short line for a shell prompt: the installed Chrome's major version and whether a matching chromedriver is at hand.

Prints `chrome 155 ✓driver`, with `✗driver` when the chromedriver is missing or of another version and `?driver` when its version cannot be read. It starts no browser and uses no network: versions come from files (a macOS app's Info.plist, the version folder beside chrome.exe), and one that only `--version` tells is cached for ten minutes in the user cache folder. Prints nothing and exits with 0 when no browser is found; --verbose says why, on standard error. The chromedriver is looked for as `sbrs doctor` does: CHROMEDRIVER_PATH, downloaded_drivers/, PATH.
"""#
    flag --format help="The line to print; placeholders {browser} {major} {driver} {mark} {driver_major}, {{ and }} for braces" default="{browser} {major} {driver}" {
        arg <TEMPLATE>
    }
    flag --ascii help="Mark the driver with + - ? instead of ✓ ✗ ?" bool_value=#true
    flag --browser-path help="Browser to report on (default: SB_CHROME_BIN, else the installed Chrome or Chromium)" {
        arg <PATH>
    }
    flag --no-cache help="Run --version again instead of using the versions cached in the user cache folder" bool_value=#true
    flag --verbose help="Explain on standard error what was found and how" bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    complete path type=path
    example "sbrs prompt"
}
