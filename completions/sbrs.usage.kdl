name sbrs
bin sbrs
version "0.5.1 (seleniumbase-rs)"
about "SeleniumBaseRust CLI"
long_about "A Rust port of the Python SeleniumBase testing framework. Provides browser automation, stealth/undetected modes, and a command-line helper."
logo #"""
 ___      _          _            ___               ___         _
/ __| ___| |___ _ _ (_)_  _ _ __ | _ ) __ _ ___ ___| _ \_  _ __| |_
\__ \/ -_) / -_) ' \| | || | '  \| _ \/ _` (_-</ -_)   / || (_-<  _|
|___/\___|_\___|_||_|_|\_,_|_|_|_|___/\__,_/__/\___|_|_\\_,_/__/\__|
"""#
unknown_flags error
args_override_self #false
subcommand_required #true
flag --webdriver help="WebDriver server URL (default: SB_WEBDRIVER_URL, else http://localhost:4444)" {
    arg <URL>
}
flag --browser help="Browser engine to launch (default: chrome, or the config file's)" {
    arg <BROWSER> {
        choices {
            choice chrome
            choice chromium
            choice edge
            choice firefox
            choice brave help="Brave, run with chromedriver."
            choice comet help="Perplexity's Comet, run with chromedriver."
            choice opera help="Opera, run with operadriver."
            choice safari help="Safari, run with safaridriver (macOS)."
            choice ie help="Internet Explorer, run with IEDriverServer (Windows)."
            choice cft help="Chrome for Testing, downloaded when missing."
            choice chs help="chrome-headless-shell, downloaded when missing."
        }
    }
}
flag --headed help="Run the browser in headed mode" bool_value=#true
flag --headless help="Run the browser in headless mode" bool_value=#true
flag --cdp help="Enable Chrome DevTools Protocol mode" bool_value=#true
flag --uc help="Enable undetected-chromedriver style evasions" bool_value=#true
flag --user-agent help="Override the default user agent string" {
    arg <USER_AGENT>
}
flag "-a --agent" help="Alias for --user-agent" {
    arg <AGENT>
}
flag --locale help="Locale string for the browser context" {
    arg <LOCALE>
}
flag --ad-block help="Refuse the requests of ad and tracker hosts (Chromium WebDriver sessions)" bool_value=#true
flag --proxy help="Proxy (host:port or scheme://host:port); with --proxy-list, a name from the list" {
    arg <PROXY>
}
flag --proxy-list help="File of proxies to choose from; without --proxy a random one is used" {
    arg <FILE>
}
flag --proxy-pac-url help="URL to a proxy auto-config (PAC) file" {
    arg <PROXY_PAC_URL>
}
flag --user-data-dir help="Path to a persistent browser user-data directory" {
    arg <USER_DATA_DIR>
}
flag --extension-dir help="Path to an unpacked extension directory" {
    arg <EXTENSION_DIR>
}
flag "--reuse-session --reuse_session --rs" help="Share browsers among the tests of the run (SB_REUSE_SESSION)" bool_value=#true
flag "--rcs --reuse-class-session --reuse_class_session" help="Share a browser among the tests of one Rust module (SB_REUSE_CLASS_SESSION)" bool_value=#true
flag --mobile help="Use a mobile device emulation profile" bool_value=#true
flag "--esc-end --esc_end --ee" help="End the current test when ESC is pressed in the browser" bool_value=#true
flag "--rec-sb-cdp --rec_sb_cdp" help="Write recordings as pure CDP code (sb_cdp Page and Locator calls)" bool_value=#true
flag "-n --threads" help="Number of parallel threads for test runs" {
    arg <THREADS>
}
flag "-c --config" help="Path to a TOML/JSON settings file" {
    arg <CONFIG>
}
flag --fingerprint help="Make every browser the command starts present the fingerprint in FILE" global=#true {
    long_help #"""
Make every browser the command starts present the fingerprint in FILE

The file is the fingerprint JSON that `sbrs fingerprint capture` and `export` write. A Chromium browser then runs in the CDP mode unless --uc or another mode is given. The command line wins over SB_FINGERPRINT, which wins over the [fingerprint] table of the settings file. The user agent, language and proxy named by their own options win over the fingerprint's.
"""#
    arg <FILE>
}
flag --plugin help="Turn on a built-in plugin in the browsers the command starts (repeatable)" var=#true {
    long_help #"""
Turn on a built-in plugin in the browsers the command starts (repeatable)

Adds to the plugins the settings file (the [plugins] table) and SB_PLUGINS turn on. Precedence, highest first: the command line, then SB_PLUGINS (which replaces the names the file enables), then the settings file. `sbrs plugin list` shows the plugins this build has. `sbrs test` passes the names on to the tests as SB_PLUGINS.
"""#
    arg <NAME>
}
flag --plugin-opt help="Set one option of a plugin, NAME.KEY=VALUE with a TOML VALUE (repeatable)" var=#true {
    long_help #"""
Set one option of a plugin, NAME.KEY=VALUE with a TOML VALUE (repeatable)

Quote the whole option so the shell keeps the quotes of a string: --plugin-opt 'shield.level="strict"'. An option given here replaces the same option from SB_PLUGINS or the settings file and keeps the plugin's other options, so the precedence is the command line, then SB_PLUGINS, then the file. The plugin must be turned on by --plugin, SB_PLUGINS or the file. Not available for `sbrs test`: put the options in the [plugins.NAME] table of the settings file.
"""#
    arg "<NAME.KEY=VALUE>"
}
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
complete file type=path
cmd version help="Print the sbrs version, as `sbrs --version` does." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd open help="Open a URL in the browser." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL to open in the browser."
}
cmd smoke help="Run a smoke test against a URL." {
    flag --title-contains help="Expected substring in the page title" {
        arg <TITLE_CONTAINS>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL to open or smoke-test"
}
