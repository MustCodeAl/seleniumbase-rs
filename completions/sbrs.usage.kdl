cmd install help_heading="Drivers, grid and servers" help="Download a driver or a browser into ./downloaded_drivers/ (Python's `sbrs get`)." {
    alias get
    long_help #"""
Download a driver or a browser into ./downloaded_drivers/ (Python's `sbrs get`).

Without a version, chromedriver and edgedriver are the drivers for the installed Chrome and Edge, and geckodriver is the newest release. uc_driver is the chromedriver patched for the UC mode; cft, chs and chromium are browsers, and chromium takes a snapshot --revision instead of a version.
"""#
    flag "-p --path" help="Also copy the driver into the folder named by SB_DRIVER_PATH_DIR (else /usr/local/bin). Never uses sudo and never replaces a symbolic link. Drivers only." bool_value=#true
    flag --revision help="The Chromium snapshot to take (chromium only); the newest when left out." {
        arg <REVISION>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <DRIVER> help="The program: chromedriver, uc_driver, geckodriver (or firefoxdriver), edgedriver (or msedgedriver), or the browsers cft, chs and chromium." {
        choices {
            choice chromedriver help="chromedriver, for Chrome."
            choice geckodriver help="geckodriver, for Firefox." {
                alias firefoxdriver hide=#true
            }
            choice edgedriver help="msedgedriver, for Microsoft Edge." {
                alias msedgedriver hide=#true
            }
            choice uc_driver help="chromedriver patched for the UC mode, kept as downloaded_drivers/uc_driver-VERSION/uc_driver." {
                alias uc-driver hide=#true
                alias ucdriver hide=#true
            }
            choice cft help="Chrome for Testing, the browser, in downloaded_drivers/cft/."
            choice chs help="chrome-headless-shell, the headless-only browser, in downloaded_drivers/chs/."
            choice chromium help="A Chromium snapshot build (see --revision), in downloaded_drivers/chromium/."
        }
    }
    arg "[VERSION]" help="A version word (stable, beta, dev, canary, latest, previous, mlatest, browser, keep), a major version, a full build, or for geckodriver a version such as 0.36.0."
    complete revision type=none
    complete version run="sbrs __complete_word__ --candidates version --line={{ words | shell_join | shell_quote }}"
    example "sbrs install chromedriver latest"
}
cmd test help_heading=Tests help="Run the project's tests, or one example, through Cargo or cargo-nextest." args_override_self=#false {
    long_help #"""
Run the project's tests, or one example, through Cargo or cargo-nextest.

Every option of Python SeleniumBase's pytest plugin is a flag of `test`, in each of its spellings (`--no-sandbox`, `--no_sandbox`, `--dcsp`): the flags reach the tests as SB_* environment variables, which a test that loads `Settings` reads. The options before the command (`sbrs --headless --browser firefox test`) reach them too, and a flag after it wins. `--plugin` reaches them as SB_PLUGINS, with the plugins the settings file and the variable already turn on; `--plugin-opt` cannot be passed on, so `sbrs test` refuses it.

`-k` and `-m` select tests as pytest does (a marker is a module name), `-n` sets how many run at once, `--co` lists them, `--pdb`, `--trace` and `--final-debug` stop in a prompt (one test at a time, output shown), `--reruns N` runs a failing test again, and `--archive-logs` keeps the old latest_logs folder, which a run otherwise empties. `-c FILE` (or `--settings-file`) names the settings file the tests read.

`sbrs test` starts the run of the tests before Cargo and ends it after: `--dashboard` writes dashboard.html (live while the tests run), `--html PATH` and `--junit-xml PATH` write a report, `--alluredir DIR` Allure results (the tested crate needs the library's `allure` feature), `--show-report` opens the report in a browser window and waits until it is closed, and `--with-db-reporting` records the run in the results database. The exit status is Cargo's, or 1 when a report could not be written. After a plain `cargo test` use `sbrs report finish`.
"""#
    flag --test help="Run one integration test file from tests/." conflicts=--example {
        arg <NAME>
    }
    flag --example help="Run one example from examples/ instead of the tests." {
        arg <NAME>
    }
    flag --release help="Build with the release profile." bool_value=#true
    flag --features help="Cargo features to enable, separated by commas." var=#true delimiter=, {
        arg <FEATURES>
    }
    flag -k help="Select tests by name, as pytest's -k: `login or signup`, `not slow`, `(a or b) and not c`." {
        arg <EXPR>
    }
    flag -m help="Select tests by marker, as pytest's -m. A marker is a module name: `-m smoke` runs the tests in `mod smoke`." {
        arg <EXPR>
    }
    flag "-n --threads" help="How many tests run at once, as pytest-xdist's -n: a number or `auto` (SB_THREADS)." {
        arg <N|auto>
    }
    flag "-s --no-capture" help="Show what the tests print as they run (pytest's -s)." bool_value=#true {
        alias --nocapture hide=#true
    }
    flag "--co --collect-only" help="List the tests that would run and how many (`collected N items`) without running them." bool_value=#true
    flag --all-scripts help="After the tests, run every example of the packages with `cargo run --example`." bool_value=#true
    flag --show-report help="Open the HTML report or the dashboard in a browser window when the tests end, and wait until the window is closed." bool_value=#true
    use test-options
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[FILTER]" help="Run only the tests whose name contains this text." conflicts=--example
    arg "[HARNESS_ARGS]..." help="Arguments for the test harness, after `--` (for example --exact)." double_dash=required
    complete filter type=none
    complete harness_args type=none
    complete name type=none
    complete features type=none
    complete expr type=none
    complete n|auto type=none
    complete path type=path
    complete value type=none
    complete dir type=dir
    complete url type=url
    complete seconds type=none
    complete count type=none
    example "sbrs test login"
    example "sbrs test -k 'login and not slow' --runner nextest --headless --browser firefox"
}
cmd behave-options help_heading=Tests help="Print how Python SeleniumBase's behave options map to `sbrs test`." {
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs behave-options"
}
cmd options help_heading="Info and setup" help="List the browser options: each flag, its `SB_*` variable and its key in the settings file." args_override_self=#false {
    long_help #"""
List the browser options: each flag, its `SB_*` variable and its key in the settings file.

The same options can be set in the settings file, in the environment and with these flags; the command line wins over the environment, which wins over the file. `--env` lists the environment variables instead, those of `sbrs-mcp` too. `--markdown` prints the table for the documentation, and `--all` adds the options of the test run (`sbrs test`).
"""#
    flag --markdown help="Print a Markdown table, for the documentation." bool_value=#true
    flag --all help="Also list the options of the test run (`sbrs test`)." bool_value=#true
    flag --env help="List the environment variables `sbrs` and `sbrs-mcp` read instead of the options." bool_value=#true {
        long_help #"""
List the environment variables `sbrs` and `sbrs-mcp` read instead of the options.

One line for each variable: who reads it, the flag that sets the same thing, what it is when it is not set, and what it sets. `--markdown` prints the table for the documentation. The table is made from the option table and the list of the other variables, so it names every variable the command lines read.
"""#
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs options"
    example "sbrs options --markdown"
}
cmd methods help_heading="Info and setup" help="List the common methods of the test API, as they are called on `sb`." {
    long_help #"""
List the common methods of the test API, as they are called on `sb`.

Python SeleniumBase's `sbase methods` in Rust spelling: the methods most tests use (`sb.open(url)`, `sb.click(selector)`, `sb.assert_text(text, selector)`, ...), each with what it does. The whole API is in `cargo doc --open`, and docs/parity.md maps Python's names to it.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs methods"
}
cmd grid-hub help_heading="Drivers, grid and servers" help="Start, stop, restart or check a Selenium Grid hub." args_override_self=#false {
    alias grid_hub
    long_help #"""
Start, stop, restart or check a Selenium Grid hub.

Needs a Selenium Server jar: --jar, SB_SELENIUM_SERVER_JAR, or the newest one in downloaded_drivers/ (`sbrs download server` saves one there). This command downloads nothing. The process record and log are kept in a folder of your own (SB_GRID_DIR).
"""#
    flag --jar help="The Selenium Server jar (default: SB_SELENIUM_SERVER_JAR, else the newest in downloaded_drivers/). This command never downloads it." {
        arg <PATH>
    }
    flag --java help="The Java executable (default: `java` on PATH)." {
        arg <PATH>
    }
    flag --grid-host help="The address to listen on." {
        arg <HOST>
    }
    flag --grid-port help="The port to listen on (default: 4444 for a hub, 5555 for a node)." {
        arg <PORT>
    }
    flag --hub help="For a node, the hub to register with: a host or a URL." {
        arg <HOST_OR_URL>
    }
    flag --timeout help="Close sessions that have been idle this many seconds." {
        arg <SECONDS>
    }
    flag --wait help="How many seconds `start` waits for the Grid to become ready." default="60" {
        arg <SECONDS>
    }
    flag "-v --verbose" help="Log at INFO instead of WARNING." bool_value=#true
    flag --skip-port-check help="Start even if something already accepts connections on the port." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ACTION> help="What to do with the Grid process." {
        choices {
            choice start help="Start it and wait until it is ready."
            choice stop help="Stop it."
            choice restart help="Stop it if it is running, then start it."
            choice status help="Say whether it is running and ready."
        }
    }
    arg "[EXTRA_ARGS]..." help="More arguments for the Selenium Server, after `--`." double_dash=required
    complete extra_args type=none
    complete path type=path
    complete host type=hostname
    complete port type=none
    complete host_or_url type=none
    complete seconds type=none
    example "sbrs grid-hub start"
    example "sbrs grid_hub start -v --timeout 120"
}
cmd grid-node help_heading="Drivers, grid and servers" help="Start, stop, restart or check a Selenium Grid node." args_override_self=#false {
    alias grid_node
    long_help #"""
Start, stop, restart or check a Selenium Grid node.

A node registers with the hub named by `--hub`, or with this machine's.
"""#
    flag --jar help="The Selenium Server jar (default: SB_SELENIUM_SERVER_JAR, else the newest in downloaded_drivers/). This command never downloads it." {
        arg <PATH>
    }
    flag --java help="The Java executable (default: `java` on PATH)." {
        arg <PATH>
    }
    flag --grid-host help="The address to listen on." {
        arg <HOST>
    }
    flag --grid-port help="The port to listen on (default: 4444 for a hub, 5555 for a node)." {
        arg <PORT>
    }
    flag --hub help="For a node, the hub to register with: a host or a URL." {
        arg <HOST_OR_URL>
    }
    flag --timeout help="Close sessions that have been idle this many seconds." {
        arg <SECONDS>
    }
    flag --wait help="How many seconds `start` waits for the Grid to become ready." default="60" {
        arg <SECONDS>
    }
    flag "-v --verbose" help="Log at INFO instead of WARNING." bool_value=#true
    flag --skip-port-check help="Start even if something already accepts connections on the port." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ACTION> help="What to do with the Grid process." {
        choices {
            choice start help="Start it and wait until it is ready."
            choice stop help="Stop it."
            choice restart help="Stop it if it is running, then start it."
            choice status help="Say whether it is running and ready."
        }
    }
    arg "[EXTRA_ARGS]..." help="More arguments for the Selenium Server, after `--`." double_dash=required
    complete extra_args type=none
    complete path type=path
    complete host type=hostname
    complete port type=none
    complete host_or_url type=none
    complete seconds type=none
    example "sbrs grid-node start"
    example "sbrs grid-node start --hub 127.0.0.1"
}
cmd translate help_heading="Files and generators" help="Write the actions of a JSON scenario in another language." {
    long_help #"""
Write the actions of a JSON scenario in another language.

Rewrites each step's `action` (`click`, `open`, ...) with the translation dictionary and changes nothing else in the file; the steps keep running, because a scenario can be read in any of the languages. Python SeleniumBase translates Python test files; a Rust test is compiled code, so this translates the portable JSON scenario instead.
"""#
    flag "-p --print" help="Print the translation and write nothing (the default)." bool_value=#true {
        conflicts --overwrite --copy
    }
    flag "-o --overwrite" help="Replace the file with the translation." conflicts=--copy bool_value=#true
    flag "-c --copy" help="Write the translation to a new file next to it, such as `login_es.json`." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="The scenario file."
    arg <LANGUAGE> help="The language: a code (en, zh, nl, fr, it, ja, ko, pt, ru, es) or its English name." {
        choices strict=#false en zh nl fr it ja ko pt ru es
    }
    complete file type=path:json
    example "sbrs translate scenario.json zh --print"
}
cmd mkdir help_heading="Files and generators" help="Create a folder with a runnable browser-test suite." args_override_self=#false {
    long_help #"""
Create a folder with a runnable browser-test suite.

Names are relative to the current directory and use letters, digits, `_`, `-` and `.`, with `/` between folders. Nothing is overwritten unless `--force` is given.

The folder is one Cargo test target (`tests/<folder>/main.rs`) with example tests that use the rstest `sb` fixture, a parameterized test and a pure CDP test. `--bdd` adds a Gherkin scenario that runs on the built-in steps, and `--gha` a GitHub Actions workflow in `.github/workflows/` of the current folder.
"""#
    flag "-b --basic" help="Create only the scaffolding, with no example tests." bool_value=#true
    flag --gha help="Also write a GitHub Actions workflow, .github/workflows/sbrs-tests.yml, here." bool_value=#true
    flag --bdd help="Also write a Gherkin scenario that runs on the built-in steps (needs the bdd feature)." bool_value=#true
    flag --force help="Replace generated files that already exist." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <DIR> help="Folder to create, for example `tests/ui`."
    complete dir type=dir
    example "sbrs mkdir ui_tests"
}
cmd mkfile help_heading="Files and generators" help="Create a browser-test file." args_override_self=#false {
    alias new
    long_help #"""
Create a browser-test file.

The name follows the same rules as `mkdir`; `.rs` is added when missing. An existing file is never overwritten unless `--force` is given.

The test uses the rstest `sb` fixture unless a syntax flag says otherwise: `--pf` (the default), `--bc` (a BaseCase made and quit by hand), `--cm` (the run_browser_test closure), `--dc` (the pure CDP `sb_cdp` fixture) or `--dm` (a pure CDP browser launched by hand). A language flag (`--en`, `--zh`, `--nl`, `--fr`, `--it`, `--ja`, `--ko`, `--pt`, `--ru`, `--es`) localises the strings it types and expects. `--rec` adds a recorder breakpoint for Recorder Mode, and `--uc` and `--cdp` write a basic test for UC Mode and for pure CDP.
"""#
    flag --url help="Page the test opens (default: https://example.com). A bare host such as wikipedia.org gets https://; the test is then the basic one." {
        arg <URL>
    }
    flag "-b --basic" help="Leave the test body empty: it only opens the page." bool_value=#true
    flag "-r --rec" help="Add a recorder breakpoint for Recorder Mode (also --record, --recorder)." bool_value=#true {
        alias --record --recorder hide=#true
    }
    flag --uc help="UC Mode: the run_browser_test closure with the UC driver, a basic body and English." bool_value=#true
    flag --cdp help="Pure CDP: the sb_cdp fixture, a basic body and English." bool_value=#true
    flag --force help="Replace the file if it already exists." bool_value=#true
    flag --en help="English strings"
    flag --english hide=#true
    flag --English hide=#true
    flag --zh help="Chinese strings"
    flag --chinese hide=#true
    flag --Chinese hide=#true
    flag --nl help="Dutch strings"
    flag --dutch hide=#true
    flag --Dutch hide=#true
    flag --fr help="French strings"
    flag --french hide=#true
    flag --French hide=#true
    flag --it help="Italian strings"
    flag --italian hide=#true
    flag --Italian hide=#true
    flag --ja help="Japanese strings"
    flag --japanese hide=#true
    flag --Japanese hide=#true
    flag --ko help="Korean strings"
    flag --korean hide=#true
    flag --Korean hide=#true
    flag --pt help="Portuguese strings"
    flag --portuguese hide=#true
    flag --Portuguese hide=#true
    flag --ru help="Russian strings"
    flag --russian hide=#true
    flag --Russian hide=#true
    flag --es help="Spanish strings"
    flag --spanish hide=#true
    flag --Spanish hide=#true
    flag --pf help="The rstest `sb` fixture (the default)"
    flag --pytest-fixture hide=#true
    flag --bc help="The BaseCase made and quit by hand"
    flag --basecase hide=#true
    flag --cm help="A closure run by run_browser_test"
    flag --context-manager hide=#true
    flag --dc help="The pure CDP `sb_cdp` fixture"
    flag --driver-context hide=#true
    flag --dm help="A pure CDP browser launched and closed by hand"
    flag --driver-manager hide=#true
    flag --cf help="Not ported: class fixtures have no Rust form (use --pf)"
    flag --class-fixture hide=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="File to create, for example `tests/login.rs`."
    complete file type=path:rs
    complete url type=url
    group language "--en" "--english" "--English" "--zh" "--chinese" "--Chinese" "--nl" "--dutch" "--Dutch" "--fr" "--french" "--French" "--it" "--italian" "--Italian" "--ja" "--japanese" "--Japanese" "--ko" "--korean" "--Korean" "--pt" "--portuguese" "--Portuguese" "--ru" "--russian" "--Russian" "--es" "--spanish" "--Spanish"
    group syntax "--pf" "--pytest-fixture" "--bc" "--basecase" "--cm" "--context-manager" "--dc" "--driver-context" "--dm" "--driver-manager" "--cf" "--class-fixture"
    example "sbrs mkfile tests/login.rs"
}
cmd commander help_heading=Tests help="Launch the Commander, a terminal app (needs a build with the `tui` feature)." {
    alias gui
    long_help #"""
Launch the Commander, a terminal app (needs a build with the `tui` feature).

Lists the tests and examples under PATH and runs the one you pick with `cargo test --test NAME` or `cargo run --example NAME`, then shows the end of the output. PATH is a project folder, a folder of test files or one test file; by default the `tests/` and `examples/` folders of the current folder. `-k FILTER` starts with the list narrowed to the names that contain FILTER, as `/` does in the app.

Python's `gui` is the same command, and its window is a terminal app here.
"""#
    flag -k help="Start with the list narrowed to the names that contain FILTER." {
        arg <FILTER>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATH]" help="A project folder, a folder of test files, or one test file."
    complete path type=path
    complete filter type=none
    example "sbrs commander"
    example "sbrs gui tests -k login"
}
cmd caseplans help_heading=Tests help="Launch the Case Plans Generator, a terminal app (needs a build with the `tui` feature)." {
    alias case-plans
    alias case_plans
    long_help #"""
Launch the Case Plans Generator, a terminal app (needs a build with the `tui` feature).

Lists the tests under PATH and creates, edits and saves a case plan for each, `case_plans/<test>.md` next to its file, and writes a summary of the plans to `case_summary.md`. PATH is a folder of tests or one test file; by default the `tests/` and `examples/` folders of the current folder. `-k FILTER` starts with the list narrowed to the tests whose id contains FILTER, as `/` does in the app.

The Python command opens a Tkinter window; this one runs in the terminal.
"""#
    flag -k help="Start with the list narrowed to the tests whose id contains FILTER." conflicts=--starter {
        arg <FILTER>
    }
    flag --starter help="Write the starter checklist `CASE_PLANS.md` instead; this needs no `tui` feature." conflicts=PATH bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATH]" help="A folder of tests, or one test file."
    complete path type=path
    complete filter type=none
    example "sbrs caseplans --starter"
    example "sbrs case_plans tests -k login"
}
cmd behave-gui help_heading=Tests help="Launch the Behave Commander, a terminal app (needs a build with the `tui` feature)." {
    alias gui-behave
    long_help #"""
Launch the Behave Commander, a terminal app (needs a build with the `tui` feature).

Lists the `.feature` files under PATH with their scenarios, runs the ones you mark with `cargo test` and shows the results. PATH is a folder of feature files or one file; by default `features`.

A scenario is matched to the test your project binds to it with rstest-bdd: one with no test named after it is reported as undefined. The Python command opens a Tkinter window; this one runs in the terminal.
"""#
    flag --new help="Prompt for a name, a title and scenarios and write a new feature file instead; this needs no `tui` feature." conflicts=PATH bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATH]" help="A folder of feature files, or one `.feature` file."
    complete path type=path:feature
    example "sbrs behave-gui features"
}
cmd print help_heading="Files and generators" help="Print a file." {
    flag --file help="File path to print" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete file type=path
    example "sbrs print --file tests/login.rs"
}
cmd objectify help_heading="Files and generators" help="Objectify a test recording." {
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs objectify"
}
cmd mkpres help_heading="Files and generators" help="Create an HTML presentation." {
    flag --file help="Output HTML presentation path" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete file type=path:html,htm
    example "sbrs mkpres --file deck.html"
}
cmd mkchart help_heading="Files and generators" help="Create an HTML chart." {
    flag --file help="Output HTML chart path" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete file type=path:html,htm
    example "sbrs mkchart --file chart.html"
}
cmd mkrec help_heading="Record and replay" help="Create a new test file with the Recorder: record your actions in a browser, then save them as a test." {
    alias codegen
    alias record
    long_help #"""
Create a new test file with the Recorder: record your actions in a browser, then save them as a test.

Python's `sbase mkrec` (also `codegen` and `record`). Starts a browser in Recorder Mode, opening --url first when it is given, and waits: type `c` and press Enter at the prompt, or press SHIFT+ESC in the browser with --ee. The recording is written to `recordings/NAME_rec.rs` and `recordings/NAME_rec.json`, shown, and copied to FILE.
"""#
    flag --overwrite help="Overwrite the file when it exists" bool_value=#true
    flag "--behave --gherkin" help="Also write the recording as a Gherkin feature (same as --rec-behave)" bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="The test file to create (FILE.rs)"
    complete file type=path:rs
    example "sbrs mkrec new_test.rs --url seleniumbase.io/demo_page"
}
cmd recorder help_heading="Record and replay" help="Launch the Recorder, a terminal app (needs a build with the `tui` feature)." {
    long_help #"""
Launch the Recorder, a terminal app (needs a build with the `tui` feature).

A form for the file name, the start page, the browser and the output format, and three actions. Record hands the terminal to `sbrs mkrec` and takes it back when the recording is over; Run starts the recorded test (`cargo test --test NAME`); Replay runs `recordings/NAME_rec.json` in a fresh browser (`sbrs replay`). `--url`, `--browser`, `--uc`, `--cdp`, `--ee`, `--rec-behave`, `--rec-sb-mgr` and `--rec-sb-cdp` fill the form in when the app starts.

Python's `sbase recorder` opens a Tkinter window; this one runs in the terminal.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs recorder"
    example "sbrs recorder --uc --url seleniumbase.io"
}
cmd run-scenario help_heading=Tests help="Run a scenario file, the way to do several steps in one browser, and write an optional dashboard." {
    flag --file help="Scenario file to run" required=#true {
        arg <FILE>
    }
    flag --dashboard help="Optional path to write a scenario dashboard" {
        arg <DASHBOARD>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete file type=path:json
    complete dashboard type=path:html,htm
    example "sbrs run-scenario --file scenario.json"
}
cmd completions help_heading="Info and setup" help="Generate a completion script for a supported shell, or a Fig spec." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SHELL> help="Shell (or `fig` for a Fig spec) to generate completions for" {
        choices {
            choice bash
            choice zsh
            choice fish
            choice elvish
            choice powershell
            choice fig help="A Fig completion spec (TypeScript), the format of the withfig/autocomplete repository that Warp's built-in completions, inshellisense and Amazon Q use."
            choice usage help="A usage spec (KDL) for jdx/usage and mise, which turn it into completions, Markdown and man pages."
        }
    }
    example "sbrs completions zsh"
}
cmd import-python help_heading="Files and generators" help="Convert common SeleniumBase or Selenium Python code into a Rust test." {
    flag "-o --output" help="Output file for the generated Rust test" {
        arg <OUTPUT>
    }
    flag --source help="Source API to assume when converting Python code" default=auto {
        arg <SOURCE> {
            choices {
                choice auto
                choice selenium-base
                choice selenium
            }
        }
    }
    flag --test-name help="Name of the generated test function" {
        arg <TEST_NAME>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Python source file to convert."
    complete file type=path:py
    complete output type=path:rs
    complete test_name type=none
    example "sbrs import-python login.py --output tests/login.rs"
}
cmd import-playwright help_heading="Files and generators" help="Convert Playwright tests or a script (JavaScript, TypeScript or Python) into Rust tests for the pure CDP engine." {
    alias import-pw
    flag "-o --output" help="Output file for the generated Rust tests" {
        arg <OUTPUT>
    }
    flag --language help="Source language (default: from the file extension, else from the content)" {
        arg <LANGUAGE> {
            choices {
                choice js help=JavaScript.
                choice ts help=TypeScript.
                choice python help=Python.
            }
        }
    }
    flag --test-name help="Name of the test generated for a script without test titles (default: the file name)" {
        arg <TEST_NAME>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Playwright source file to convert."
    complete file type=path:js,ts,py
    complete output type=path:rs
    complete test_name type=none
    example "sbrs import-playwright login.spec.ts --output tests/login.rs"
}
cmd import-puppeteer help_heading="Files and generators" help="Convert Puppeteer scripts or tests (JavaScript, TypeScript) or a Chrome Recorder JSON export into Rust tests for the pure CDP engine." {
    alias import-pptr
    flag "-o --output" help="Output file for the generated Rust tests" {
        arg <OUTPUT>
    }
    flag --language help="Source language (default: from the file extension, else from the content)" {
        arg <LANGUAGE> {
            choices {
                choice js help=JavaScript.
                choice ts help=TypeScript.
                choice json help="A Chrome DevTools Recorder JSON export."
            }
        }
    }
    flag --test-name help="Name of the test generated for a script without test titles (default: the file name)" {
        arg <TEST_NAME>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Puppeteer source file (or Recorder `.json` export) to convert."
    complete file type=path:js,ts,json
    complete output type=path:rs
    complete test_name type=none
    example "sbrs import-puppeteer login.js --output tests/login.rs"
}
cmd download-file help_heading="Page commands" help="Download a file from a URL (browser download with an HTTP fallback)." {
    flag "-o --output" help="Output file path (defaults to the URL file name in the current directory)" {
        arg <OUTPUT>
    }
    flag --timeout help="Seconds to wait for the browser download before falling back to HTTP" default="30" {
        arg <TIMEOUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL of the file to download"
    complete url type=url
    complete output type=path
    complete timeout type=none
    example "sbrs download-file https://example.com/report.pdf --output report.pdf"
}
cmd print-pdf help_heading="Page commands" help="Print a page to PDF and save it to disk." {
    flag "-o --output" help="Output PDF file path" default=page.pdf {
        arg <OUTPUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL to render as a PDF"
    complete url type=url
    complete output type=path:pdf
    example "sbrs print-pdf https://example.com --output page.pdf"
}
cmd pdf-text help_heading="Page commands" help="Print the text extracted from a page or PDF URL." {
    flag --save-pdf help="Also keep the intermediate PDF at this path" {
        arg <SAVE_PDF>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL of the page or PDF to extract text from"
    complete url type=url
    complete save_pdf type=path:pdf
    example "sbrs pdf-text https://example.com/report.pdf"
}
cmd assert-pdf-text help_heading="Page commands" help="Assert that a page or PDF URL contains the expected text." {
    flag --text help="Text that must appear in the PDF" required=#true {
        arg <TEXT>
    }
    flag --save-pdf help="Also keep the intermediate PDF at this path" {
        arg <SAVE_PDF>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL of the page or PDF to check"
    complete url type=url
    complete text type=none
    complete save_pdf type=path:pdf
    example "sbrs assert-pdf-text https://example.com/report.pdf --text Total"
}
cmd choose-file help_heading="Page commands" help="Upload a local file into a file input." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SELECTOR> help="CSS selector of the <input type=file> element"
    arg <FILE> help="Local file to upload"
    complete selector type=none
    complete file type=path
    example "sbrs --url https://example.com/upload choose-file 'input[type=file]' ./photo.png"
}
cmd deferred help_heading="Page commands" help="Run several assertions, then report every failure at once." {
    long_help #"""
Run several assertions, then report every failure at once.

The page they run on is the global --url, if there is one.
"""#
    flag --assert help="Assertion spec: element=<css>, text=<css>:<text>, title=<text>, or url=<text>" var=#true {
        arg <SPEC>
    }
    flag --spec help="JSON file containing an array of assertion specs" {
        arg <SPEC>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete spec type=none
    complete spec type=path:json
    example "sbrs --url https://example.com deferred --assert element=p --assert 'text=p:This domain is for use in'"
}
cmd replay help_heading="Record and replay" help="Replay a recorded action file (recordings/NAME_rec.json) against a fresh browser." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="JSON or YAML action file (recordings/NAME_rec.json)"
    complete file type=path:json,yaml
    example "sbrs replay recordings/new_test_rec.json"
}
cmd devtools help_heading="Drivers, grid and servers" help="Launch Chrome with an open DevTools endpoint and print MCP client configs." {
    long_help #"""
Launch Chrome with an open DevTools endpoint and print MCP client configs.

Starts Chrome with the Pure CDP engine (no chromedriver), prints the DevTools HTTP endpoint, the browser WebSocket URL and configs for Google's chrome-devtools-mcp and Microsoft's Playwright MCP, then keeps the browser running until Ctrl+C, which closes it and exits with 0. The global --browser (chrome, chromium, edge or another Chromium browser), --headless, --headed, --user-data-dir, --proxy, --user-agent, --locale, --ad-block, --extension-dir --proxy-list and --url (the page to open once the browser runs) apply as well.
"""#
    flag --port help="DevTools port on 127.0.0.1 (0 lets Chrome pick a free one)" default="9222" {
        arg <PORT>
    }
    flag --browser-path help="Browser binary to launch, such as Microsoft Edge or another Chromium browser" {
        arg <PATH>
    }
    flag --json help="Print the endpoint and configs as one line of JSON instead of text" bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    complete port type=none
    complete path type=executable
    example "sbrs devtools --port 9222"
}
cmd plugin help_heading="Info and setup" help="List the built-in plugins, or show what one declares." subcommand_required=#true {
    long_help #"""
List the built-in plugins, or show what one declares.

Plugins run inside the browsers a command starts. Turn them on by name with the global options --plugin and --plugin-opt, the SB_PLUGINS variable, or the [plugins] table of the settings file; the command line wins over SB_PLUGINS, which wins over the file. `sbrs plugin list` shows the plugins this build has.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd list help="List the built-in plugins of this build, and whether they are on." {
        long_help #"""
List the built-in plugins of this build, and whether they are on.

Prints each plugin's name, category and summary, and `yes` under ENABLED when the settings file, SB_PLUGINS or the global --plugin option turns it on. A build without built-in plugins says so; rebuild it with --features plugins-builtin.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        example "sbrs plugin list"
    }
    cmd info help="Show what one plugin declares and what it may do." {
        long_help #"""
Show what one plugin declares and what it may do.

Prints the plugin's category, phase, capabilities (with their risk, and whether the host enforces them), what it needs, its place among the other plugins and the options it was given. Exits with status 2 and lists the known names when there is no such plugin.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <NAME> help="The plugin's name, as `sbrs plugin list` shows it."
        complete name type=none
        example "sbrs plugin info shield"
    }
    cmd run help="Run the task of a plugin on a browser it starts, and write its results as JSON lines." {
        long_help #"""
Run the task of a plugin on a browser it starts, and write its results as JSON lines.

Only plugins that offer a task can be run, and the named plugin is turned on for this run without --plugin. The task reads its input from --input (a JSON file, or `-` for standard input; `{}` when there is none) and writes one JSON value per line to --out (default: standard output). Its summary goes to standard error. The global options --plugin, --plugin-opt, --headless, --proxy and the like shape the browser and the other plugins. Ctrl-C stops the task, closes the browser and exits with status 130. Exits with status 2 and lists the plugins that have a task when the name is not one of them.
"""#
        flag --input help="A JSON file with the task's input, or `-` to read it from standard input." {
            arg <FILE>
        }
        flag --out help="Write the results to this file, one JSON value per line (default: standard output)." {
            arg <FILE>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <NAME> help="The plugin whose task to run, as `sbrs plugin list` shows it."
        complete name type=none
        complete file type=path
        example "sbrs plugin run crawler --input crawl.json --out found.jsonl"
    }
    example "sbrs plugin list"
}
cmd fingerprint help_heading=Security help="Capture, write, check and compare browser fingerprints." subcommand_required=#true {
    long_help #"""
Capture, write, check and compare browser fingerprints.

A fingerprint file is what a browser claims to be: the user agent, the screen, the language, the graphics card and the rest, as one JSON file. `capture` reads it from a real browser; `export` writes a preset or a random identity; `check` and `diff` read files. The global --fingerprint FILE (or SB_FINGERPRINT, or the [fingerprint] table of the settings file) makes every browser a command starts present one.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd capture help="Read the fingerprint of a real browser and write it as a fingerprint file." args_override_self=#false {
        long_help #"""
Read the fingerprint of a real browser and write it as a fingerprint file.

Starts a browser as `sbrs open` does (the global --browser, --headless, --proxy and the rest apply), opens URL (a blank page when there is none), reads what a page can see of the browser, and prints the fingerprint as JSON, or writes it to FILE. A summary goes to standard error. What no setting holds (window sizes, the automation markers, the canvas hash) stays out of the fingerprint; --readings writes it to its own file.
"""#
        flag "-o --output" help="Write the fingerprint to FILE instead of printing it." {
            arg <FILE>
        }
        flag --readings help="Also write the readings that no setting holds, and where the capture was taken, to FILE." {
            arg <FILE>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        arg "[URL]" help="The page to open first (default: a blank page)."
        complete url type=url
        complete file type=path:json
        example "sbrs fingerprint capture https://example.com --output seen.json"
    }
    cmd export help="Write a preset or a random identity as a fingerprint file." args_override_self=#false {
        long_help #"""
Write a preset or a random identity as a fingerprint file.

Give --preset NAME (windows, edge, macos, linux, android, ios) or --random. A random identity follows --seed, so the same seed gives the same file, and --os, the system it claims (default: this machine's). The file goes to FILE, else to standard output.
"""#
        flag --preset help="The preset to write: windows, edge, macos, linux, android or ios (safari is ios)." {
            arg <NAME> {
                choices strict=#false windows edge macos linux android ios
            }
        }
        flag --random help="Write a random identity instead of a preset." bool_value=#true
        flag --seed help="With --random, the seed of the draw: the same seed gives the same identity." {
            arg <N>
        }
        flag --os help="With --random, the system the identity claims (default: this machine's)." {
            arg <OS> {
                choices {
                    choice windows
                    choice macos
                    choice linux
                    choice android
                    choice ios
                }
            }
        }
        flag "-o --output" help="Write the fingerprint to FILE instead of printing it." {
            arg <FILE>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        complete n type=none
        complete file type=path:json
        example "sbrs fingerprint export --preset windows --output windows.json"
    }
    cmd check help="Check that a fingerprint file loads and is coherent." {
        long_help #"""
Check that a fingerprint file loads and is coherent.

Prints how many settings the file gives, each error and warning, and the verdict. Exits with status 2 when there is an error or the file does not load.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <FILE> help="The fingerprint file to check."
        complete file type=path:json
        example "sbrs fingerprint check windows.json"
    }
    cmd diff help="Compare two fingerprint files." {
        long_help #"""
Compare two fingerprint files.

EXPECTED is what is expected and FOUND what is found: a setting that EXPECTED leaves natural is never compared. Prints each setting that differs. Exits with status 1 when any differs, 0 when none does, and 2 when a file does not load.

To check that a browser presents a file: `sbrs --fingerprint f.json fingerprint capture -o seen.json`, then `sbrs fingerprint diff f.json seen.json`.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <EXPECTED> help="The file with what is expected."
        arg <FOUND> help="The file with what is found."
        complete expected type=path:json
        complete found type=path:json
        example "sbrs fingerprint diff windows.json seen.json"
    }
    cmd presets help="List the presets and what each claims." {
        flag "-h --help" help="Print help" action=help builtin=#true
        example "sbrs fingerprint presets"
    }
    example "sbrs fingerprint presets"
}
