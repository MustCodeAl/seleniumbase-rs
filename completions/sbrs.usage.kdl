// @generated by usage-cli from clap metadata
name sbrs
bin sbrs
version "0.3.0 (seleniumbase-rs)"
about "SeleniumBaseRust CLI"
long_about "A Rust port of the Python SeleniumBase testing framework. Provides browser automation, stealth/undetected modes, and a command-line helper."
usage "Usage: sbrs [OPTIONS] <COMMAND>"
flag --webdriver help="WebDriver server URL (default: SB_WEBDRIVER_URL, else http://localhost:4444)" {
    arg <URL>
}
flag --browser help="Browser engine to launch (default: chrome, or the config file's)" {
    arg <BROWSER> {
        choices chrome chromium edge firefox brave comet opera safari ie cft chs
    }
}
flag --headed help="Run the browser in headed mode" default="false"
flag --headless help="Run the browser in headless mode" default="false"
flag --cdp help="Enable Chrome DevTools Protocol mode" default="false"
flag --uc help="Enable undetected-chromedriver style evasions" default="false"
flag --user-agent help="Override the default user agent string" {
    arg <USER_AGENT>
}
flag "-a --agent" help="Alias for --user-agent" {
    arg <AGENT>
}
flag --locale help="Locale string for the browser context" {
    arg <LOCALE>
}
flag --ad-block help="Refuse the requests of ad and tracker hosts (Chromium WebDriver sessions)" default="false"
flag --proxy help="Proxy (host:port or scheme://host:port); with --proxy-list, a name from the list" {
    arg <PROXY>
}
flag --proxy-list help="File of proxies to choose from; without --proxy a random one is used" {
    arg <FILE>
}
flag --proxy-pac-url help="URL to a proxy auto-config (PAC) file" {
    arg <PROXY_PAC_URL>
}
flag --user-data-dir help="Path to a persistent browser user-data directory" {
    arg <USER_DATA_DIR>
}
flag --extension-dir help="Path to an unpacked extension directory" {
    arg <EXTENSION_DIR>
}
flag "--reuse-session --reuse_session --rs" help="Share browsers among the tests of the run (SB_REUSE_SESSION)" default="false"
flag "--rcs --reuse-class-session --reuse_class_session" help="Share a browser among the tests of one Rust module (SB_REUSE_CLASS_SESSION)" default="false"
flag --mobile help="Use a mobile device emulation profile" default="false"
flag "--esc-end --esc_end --ee" help="End the current test when ESC is pressed in the browser" default="false"
flag "--rec-sb-cdp --rec_sb_cdp" help="Write recordings as pure CDP code (sb_cdp Page and Locator calls)" default="false"
flag "-n --threads" help="Number of parallel threads for test runs" {
    arg <THREADS>
}
flag "-c --config" help="Path to a TOML/JSON settings file" {
    arg <CONFIG>
}
cmd version help="Print the sbrs version, as `sbrs --version` does"
cmd open help="Open a URL in the browser" {
    arg <URL> help="URL to open in the browser"
}
cmd smoke help="Run a smoke test against a URL" {
    flag --title-contains help="Expected substring in the page title" {
        arg <TITLE_CONTAINS>
    }
    arg <URL> help="URL to open or smoke-test"
}
cmd cdp help="Execute a Chrome DevTools Protocol command" {
    flag --cmd help="CDP method name (e.g. Runtime.evaluate)" required=#true {
        arg <CMD>
    }
    flag --params help="JSON object of CDP parameters" {
        arg <PARAMS>
    }
}
cmd cache-clear help="Clear the browser cache via CDP"
cmd throttle3g help="Throttle the browser connection to 3G speeds"
cmd screenshot help="Capture a screenshot of the current page" {
    flag --path help="Output image file path (default: a new file in latest_logs/)" {
        arg <PATH>
    }
}
cmd save-source help="Save the current page source to a file" {
    flag --path help="Output HTML file path (default: a new file in latest_logs/)" {
        arg <PATH>
    }
}
