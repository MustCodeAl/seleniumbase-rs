name sbrs
bin sbrs
version "0.6.0 (seleniumbase-rs)"
about "SeleniumBaseRust CLI"
long_about "A Rust port of the Python SeleniumBase testing framework. Provides browser automation, stealth/undetected modes, and a command-line helper."
logo #"""
 ___      _          _            ___               ___         _
/ __| ___| |___ _ _ (_)_  _ _ __ | _ ) __ _ ___ ___| _ \_  _ __| |_
\__ \/ -_) / -_) ' \| | || | '  \| _ \/ _` (_-</ -_)   / || (_-<  _|
|___/\___|_\___|_||_|_|\_,_|_|_|_|___/\__,_/__/\___|_|_\\_,_/__/\__|
"""#
unknown_flags error
args_override_self #false
subcommand_required #true
flagset test-options {
    flag --browser help="The browser to run: chrome, edge, firefox, brave, ... (SB_BROWSER)" help_heading="Browser and page options" {
        arg <BROWSER> {
            choices strict=#false chrome chromium edge firefox brave comet opera safari ie cft chs
        }
    }
    flag --headless help="Run without a visible window (Chrome's new headless mode) (SB_HEADLESS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --headless2 hide=#true
        arg "[HEADLESS]" required=#false {
            choices "true" "false"
        }
    }
    flag --binary-location help="The browser binary to run (SB_CHROME_BIN)" help_heading="Browser and page options" {
        alias --bl hide=#true
        arg <PATH>
    }
    flag --proxy help="The proxy server: HOST:PORT or USER:PASS@HOST:PORT (SB_PROXY)" help_heading="Browser and page options" {
        alias --proxy-server --proxy-string hide=#true
        arg <VALUE>
    }
    flag --user-data-dir help="The browser profile folder (SB_USER_DATA_DIR)" help_heading="Browser and page options" {
        arg <DIR>
    }
    flag --extension-dir help="Unpacked extension folders to load, separated by commas (SB_EXTENSION_DIR)" help_heading="Browser and page options" {
        arg <DIR>
    }
    flag --locale help="The browser locale (SB_LOCALE)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --user-agent help="The user agent string (SB_USER_AGENT)" help_heading="Browser and page options" {
        alias --agent hide=#true
        arg <VALUE>
    }
    flag --mode help="The driver mode: webdriver, cdp or uc (SB_MODE)" help_heading="Browser and page options" {
        arg <MODE> {
            choices webdriver cdp uc
        }
    }
    flag --ad-block help="Block the requests of ad and tracker hosts (SB_AD_BLOCK)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --adblock --block-ads hide=#true
        arg "[AD_BLOCK]" required=#false {
            choices "true" "false"
        }
    }
    flag --reuse-session help="Share browsers among the tests of the run (SB_REUSE_SESSION)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --rs hide=#true
        arg "[REUSE_SESSION]" required=#false {
            choices "true" "false"
        }
    }
    flag --reuse-class-session help="Share a browser among the tests of one module (SB_REUSE_CLASS_SESSION)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --rcs hide=#true
        arg "[REUSE_CLASS_SESSION]" required=#false {
            choices "true" "false"
        }
    }
    flag --mobile help="Emulate a mobile phone (SB_MOBILE)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --mobile-emulator hide=#true
        arg "[MOBILE]" required=#false {
            choices "true" "false"
        }
    }
    flag --proxy-pac-url help="A proxy auto-config URL (SB_PROXY_PAC_URL)" help_heading="Browser and page options" {
        alias --pac-url hide=#true
        arg <URL>
    }
    flag --esc-end help="End the current test when ESC is pressed in the browser (SB_ESC_END)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --ee hide=#true
        arg "[ESC_END]" required=#false {
            choices "true" "false"
        }
    }
    flag --rec-sb-cdp help="Write recordings as pure CDP code (SB_REC_SB_CDP)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[REC_SB_CDP]" required=#false {
            choices "true" "false"
        }
    }
    flag --fingerprint help="A fingerprint file every browser presents (SB_FINGERPRINT)" help_heading="Browser and page options" {
        arg <PATH>
    }
    flag --start-page help="The page every browser opens first (SB_START_PAGE)" help_heading="Browser and page options" {
        alias --url hide=#true
        arg <URL>
    }
    flag --settings-file help="The settings file to read instead of sbase_config.toml (SB_SETTINGS_FILE)" help_heading="Browser and page options" {
        alias --settings hide=#true
        arg <PATH>
    }
    flag --chrome help="Run Chrome (SB_BROWSER=chrome)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[CHROME]" required=#false {
            choices "true" "false"
        }
    }
    flag --edge help="Run Edge (SB_BROWSER=edge)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[EDGE]" required=#false {
            choices "true" "false"
        }
    }
    flag --firefox help="Run Firefox (SB_BROWSER=firefox)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[FIREFOX]" required=#false {
            choices "true" "false"
        }
    }
    flag --brave help="Run Brave (SB_BROWSER=brave)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[BRAVE]" required=#false {
            choices "true" "false"
        }
    }
    flag --comet help="Run Comet (SB_BROWSER=comet)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[COMET]" required=#false {
            choices "true" "false"
        }
    }
    flag --opera help="Run Opera (SB_BROWSER=opera)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[OPERA]" required=#false {
            choices "true" "false"
        }
    }
    flag --safari help="Run Safari (SB_BROWSER=safari)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[SAFARI]" required=#false {
            choices "true" "false"
        }
    }
    flag --ie help="Run Internet Explorer (SB_BROWSER=ie)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[IE]" required=#false {
            choices "true" "false"
        }
    }
    flag --cft help="Run Chrome for Testing (SB_BROWSER=cft)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[CFT]" required=#false {
            choices "true" "false"
        }
    }
    flag --chs help="Run chrome-headless-shell (SB_BROWSER=chs)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[CHS]" required=#false {
            choices "true" "false"
        }
    }
    flag --chromium help="Run Chromium (SB_BROWSER=chromium)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --use-chromium hide=#true
        arg "[CHROMIUM]" required=#false {
            choices "true" "false"
        }
    }
    flag --headed help="Run with a visible window (SB_HEADLESS=false)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --gui hide=#true
        arg "[HEADED]" required=#false {
            choices "true" "false"
        }
    }
    flag --uc help="Run in undetected-chromedriver mode (SB_MODE=uc)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --undetected --undetectable hide=#true
        arg "[UC]" required=#false {
            choices "true" "false"
        }
    }
    flag --headless1 help="Run headless with chrome-headless-shell (Chrome's old headless mode) (SB_HEADLESS1)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[HEADLESS1]" required=#false {
            choices "true" "false"
        }
    }
    flag --locale-code help="The browser language code, such as fr or ar_eg (SB_LOCALE_CODE)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --server help="The Selenium Grid server to connect to (SB_SERVER)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --port help="The port of the Selenium Grid server (SB_PORT)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --protocol help="The protocol of the Selenium Grid server: http or https (SB_PROTOCOL)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --chromium-arg help="Extra Chromium switches, separated by commas (SB_CHROMIUM_ARG)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --dark-mode help="Force Chrome's dark theme on web pages (SB_DARK_MODE)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --dark hide=#true
        arg "[DARK_MODE]" required=#false {
            choices "true" "false"
        }
    }
    flag --devtools help="Open the developer tools with each tab (headed only) (SB_DEVTOOLS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --open-devtools hide=#true
        arg "[DEVTOOLS]" required=#false {
            choices "true" "false"
        }
    }
    flag --disable-features help="Chromium features to switch off, separated by commas (SB_DISABLE_FEATURES)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --disable-gpu help="Switch the GPU off (SB_DISABLE_GPU)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[DISABLE_GPU]" required=#false {
            choices "true" "false"
        }
    }
    flag --disable-ws help="Switch web security off (SB_DISABLE_WS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --dws --disable-web-security hide=#true
        arg "[DISABLE_WS]" required=#false {
            choices "true" "false"
        }
    }
    flag --guest-mode help="Open the browser as a guest (SB_GUEST_MODE)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --guest hide=#true
        arg "[GUEST_MODE]" required=#false {
            choices "true" "false"
        }
    }
    flag --incognito help="Open the browser in an incognito window (SB_INCOGNITO)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --incognito-mode hide=#true
        arg "[INCOGNITO]" required=#false {
            choices "true" "false"
        }
    }
    flag --host-resolver-rules help="Chromium rules that map host names to addresses (SB_HOST_RESOLVER_RULES)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --no-sandbox help="Start Chromium without its sandbox (SB_NO_SANDBOX)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[NO_SANDBOX]" required=#false {
            choices "true" "false"
        }
    }
    flag --swiftshader help="Render with SwiftShader, a software WebGL renderer (SB_SWIFTSHADER)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[SWIFTSHADER]" required=#false {
            choices "true" "false"
        }
    }
    flag --enable-3d-apis help="Keep the GPU on in a headless session, for WebGL (SB_ENABLE_3D_APIS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[ENABLE_3D_APIS]" required=#false {
            choices "true" "false"
        }
    }
    flag --maximize help="Maximize the browser window (SB_MAXIMIZE)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --maximize-window --fullscreen hide=#true
        arg "[MAXIMIZE]" required=#false {
            choices "true" "false"
        }
    }
    flag --block-images help="Do not load images (SB_BLOCK_IMAGES)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[BLOCK_IMAGES]" required=#false {
            choices "true" "false"
        }
    }
    flag --disable-js help="Turn JavaScript off (SB_DISABLE_JS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[DISABLE_JS]" required=#false {
            choices "true" "false"
        }
    }
    flag --disable-cookies help="Refuse every cookie (SB_DISABLE_COOKIES)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[DISABLE_COOKIES]" required=#false {
            choices "true" "false"
        }
    }
    flag --do-not-track help="Send the DNT: 1 header (SB_DO_NOT_TRACK)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[DO_NOT_TRACK]" required=#false {
            choices "true" "false"
        }
    }
    flag --external-pdf help="Download PDF files instead of showing them (SB_EXTERNAL_PDF)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[EXTERNAL_PDF]" required=#false {
            choices "true" "false"
        }
    }
    flag --enable-sync help="Leave Chrome Sync on (SB_ENABLE_SYNC)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[ENABLE_SYNC]" required=#false {
            choices "true" "false"
        }
    }
    flag --disable-csp help="Strip the Content Security Policy from every response (SB_DISABLE_CSP)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --dcsp --no-csp hide=#true
        arg "[DISABLE_CSP]" required=#false {
            choices "true" "false"
        }
    }
    flag --use-auto-ext help="Keep Chrome's automation extension (SB_USE_AUTO_EXT)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --auto-ext hide=#true
        arg "[USE_AUTO_EXT]" required=#false {
            choices "true" "false"
        }
    }
    flag --proxy-driver help="Download the driver through the proxy (SB_PROXY_DRIVER)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[PROXY_DRIVER]" required=#false {
            choices "true" "false"
        }
    }
    flag --page-load-strategy help="How long a navigation waits: normal, eager or none (SB_PAGE_LOAD_STRATEGY)" help_heading="Browser and page options" {
        alias --pls hide=#true
        arg <STRATEGY> {
            choices normal eager none
        }
    }
    flag --window-size help="The window size: WIDTH,HEIGHT (SB_WINDOW_SIZE)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --window-position help="The window position: X,Y (SB_WINDOW_POSITION)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --device-metrics help="Emulate a phone screen: WIDTH,HEIGHT,PIXEL_RATIO (SB_DEVICE_METRICS)" help_heading="Browser and page options" {
        alias --metrics hide=#true
        arg <VALUE>
    }
    flag --proxy-bypass-list help="Hosts that skip the proxy (SB_PROXY_BYPASS_LIST)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --driver-version help="The driver version: a number, latest, stable, beta, ... (SB_DRIVER_VERSION)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --cap-file help="A JSON file of capabilities to add to the session's (SB_CAP_FILE)" help_heading="Browser and page options" {
        arg <PATH>
    }
    flag --cap-string help="A JSON object of capabilities to add to the session's (SB_CAP_STRING)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --extension-zip help="Extension .zip or .crx files to load, separated by commas (SB_EXTENSION_ZIP)" help_heading="Browser and page options" {
        alias --crx hide=#true
        arg <VALUE>
    }
    flag --firefox-arg help="Firefox arguments, separated by commas (SB_FIREFOX_ARG)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --firefox-pref help="Firefox preferences, NAME:VALUE separated by commas (SB_FIREFOX_PREF)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --xvfb help="Open a virtual display for a headed browser on Linux (SB_XVFB)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[XVFB]" required=#false {
            choices "true" "false"
        }
    }
    flag --xvfb-metrics help="The virtual display size: WIDTH,HEIGHT (SB_XVFB_METRICS)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --remote-debug help="Open Chrome's remote debugger on port 9222 (SB_REMOTE_DEBUG)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --remote-debugger hide=#true
        arg "[REMOTE_DEBUG]" required=#false {
            choices "true" "false"
        }
    }
    flag --log-cdp-events help="Log the DevTools Protocol events (SB_LOG_CDP_EVENTS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --log-cdp hide=#true
        arg "[LOG_CDP_EVENTS]" required=#false {
            choices "true" "false"
        }
    }
    flag --uc-cdp-events help="Log the DevTools Protocol events in undetected mode (SB_UC_CDP_EVENTS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --uc-cdp hide=#true
        arg "[UC_CDP_EVENTS]" required=#false {
            choices "true" "false"
        }
    }
    flag --demo help="Highlight each element and pause after an action (SB_DEMO)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --demo-mode hide=#true
        arg "[DEMO]" required=#false {
            choices "true" "false"
        }
    }
    flag --slow help="Pause briefly after each action (SB_SLOW)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --slow-mode --slowmo hide=#true
        arg "[SLOW]" required=#false {
            choices "true" "false"
        }
    }
    flag --demo-sleep help="Seconds to pause after each action in demo mode (SB_DEMO_SLEEP)" help_heading="Browser and page options" {
        arg <SECONDS>
    }
    flag --message-duration help="Seconds a message stays on the page (SB_MESSAGE_DURATION)" help_heading="Browser and page options" {
        arg <SECONDS>
    }
    flag --skip-js-waits help="Do not wait for the page's JavaScript to settle (SB_SKIP_JS_WAITS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --sjw hide=#true
        arg "[SKIP_JS_WAITS]" required=#false {
            choices "true" "false"
        }
    }
    flag --highlights help="How many times to flash a highlighted element (SB_HIGHLIGHTS)" help_heading="Browser and page options" {
        arg <COUNT>
    }
    flag --interval help="Seconds between the steps of a tour or presentation (SB_INTERVAL)" help_heading="Browser and page options" {
        arg <SECONDS>
    }
    flag --verify-delay help="Seconds to wait before each MasterQA verification (SB_VERIFY_DELAY)" help_heading="Browser and page options" {
        arg <SECONDS>
    }
    flag --check-js help="Check each page for JavaScript errors after it opens (SB_CHECK_JS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[CHECK_JS]" required=#false {
            choices "true" "false"
        }
    }
    flag --wait-for-angularjs help="Wait for AngularJS after opening a page and clicking (SB_WAIT_FOR_ANGULARJS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        alias --wfa hide=#true
        arg "[WAIT_FOR_ANGULARJS]" required=#false {
            choices "true" "false"
        }
    }
    flag --disable-beforeunload help="Remove the beforeunload prompt after each page opens (SB_DISABLE_BEFOREUNLOAD)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[DISABLE_BEFOREUNLOAD]" required=#false {
            choices "true" "false"
        }
    }
    flag --visual-baseline help="Set the visual baselines again instead of comparing (SB_VISUAL_BASELINE)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[VISUAL_BASELINE]" required=#false {
            choices "true" "false"
        }
    }
    flag --crumbs help="Delete the cookies when a reused browser is handed to the next test (SB_CRUMBS)" help_heading="Browser and page options" require_equals=#true value_optional=#true default_missing="true" {
        arg "[CRUMBS]" required=#false {
            choices "true" "false"
        }
    }
    flag --timeout-multiplier help="Multiply the default waits by this number (SB_TIMEOUT_MULTIPLIER)" help_heading="Browser and page options" {
        arg <VALUE>
    }
    flag --rec-sleep help="Keep the sleeps of a recording (SB_REC_SLEEP)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        alias --record-sleep hide=#true
        arg "[REC_SLEEP]" required=#false {
            choices "true" "false"
        }
    }
    flag --env help="The environment the tests run against: qa, staging, production, ... (SB_ENV)" help_heading="Test data" {
        arg <ENV> {
            choices strict=#false qa rc staging develop production performance replica fedramp offline online master remote legacy local alpha beta demo gdpr main test gov new old uat
        }
    }
    flag --account help="A free account name for the tests (SB_ACCOUNT)" help_heading="Test data" {
        arg <VALUE>
    }
    flag --data help="Free test data (SB_DATA)" help_heading="Test data" {
        arg <VALUE>
    }
    flag --var1 help="A free variable for the tests (SB_VAR1)" help_heading="Test data" {
        arg <VALUE>
    }
    flag --var2 help="A free variable for the tests (SB_VAR2)" help_heading="Test data" {
        arg <VALUE>
    }
    flag --var3 help="A free variable for the tests (SB_VAR3)" help_heading="Test data" {
        arg <VALUE>
    }
    flag --variables help="A dictionary of values: JSON or a Python dictionary literal (SB_VARIABLES)" help_heading="Test data" {
        arg <VALUE>
    }
    flag --pdb help="Stop in a post-mortem prompt when a test fails (SB_PDB)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        arg "[PDB]" required=#false {
            choices "true" "false"
        }
    }
    flag --trace help="Stop in a prompt before each test's body (SB_TRACE)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        arg "[TRACE]" required=#false {
            choices "true" "false"
        }
    }
    flag --final-debug help="Stop in a prompt after each test, before the browser quits (SB_FINAL_DEBUG)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        alias --fdebug --final-trace --ftrace hide=#true
        arg "[FINAL_DEBUG]" required=#false {
            choices "true" "false"
        }
    }
    flag --reruns help="Run a failing test again this many times (SB_RERUNS)" help_heading="Test run, debugging and reports" {
        arg <COUNT>
    }
    flag --reruns-delay help="Seconds to wait between reruns (SB_RERUNS_DELAY)" help_heading="Test run, debugging and reports" {
        arg <SECONDS>
    }
    flag --time-limit help="Fail a test that runs longer than this many seconds (SB_TIME_LIMIT)" help_heading="Test run, debugging and reports" {
        alias --timelimit hide=#true
        arg <SECONDS>
    }
    flag --runner help="The test runner: cargo or nextest (SB_TEST_RUNNER)" help_heading="Test run, debugging and reports" {
        arg <RUNNER> {
            choices cargo nextest
        }
    }
    flag --screenshot help="Save a screenshot of passing tests too (SB_SAVE_SCREENSHOT)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        alias --save-screenshot --ss hide=#true
        arg "[SCREENSHOT]" required=#false {
            choices "true" "false"
        }
    }
    flag --no-screenshot help="Save no screenshot of failing tests (SB_NO_SCREENSHOT)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        alias --ns hide=#true
        arg "[NO_SCREENSHOT]" required=#false {
            choices "true" "false"
        }
    }
    flag --list-fail-page help="Print the URL of the page a failing test ended on (SB_LIST_FAIL_PAGE)" help_heading="Test run, debugging and reports" require_equals=#true value_optional=#true default_missing="true" {
        alias --list-fail-pages --lfp hide=#true
        arg "[LIST_FAIL_PAGE]" required=#false {
            choices "true" "false"
        }
    }
