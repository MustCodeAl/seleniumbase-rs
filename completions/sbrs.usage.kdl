cmd wait-for-element-present help_heading="Page commands" help="Wait until an element is present in the DOM." {
    flag --css help="CSS selector for the target element" required=#true {
        arg <CSS>
    }
    flag --timeout help="Maximum wait time in seconds" default="10" {
        arg <TIMEOUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs --url https://example.com wait-for-element-present --css h1 --timeout 5"
}
