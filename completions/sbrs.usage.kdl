cmd install help="Download a driver into ./downloaded_drivers/ (Python's `sbrs get`)" {
    alias get
    long_help #"""
Download a driver into ./downloaded_drivers/ (Python's `sbrs get`).

Without a version, chromedriver and edgedriver are the drivers for the installed Chrome and Edge, and geckodriver is the newest release.
"""#
    arg "[DRIVER]" help="The driver: chromedriver, geckodriver (or firefoxdriver), edgedriver (or msedgedriver)" required=#false default=chromedriver
    arg "[VERSION]" help="`latest`, a major version (chromedriver, edgedriver), a full build, or a geckodriver version such as 0.36.0" required=#false
}
cmd test help="Run the project's tests, or one example, through Cargo" {
    long_help #"""
Run the project's tests, or one example, through Cargo.

The global options reach the tests as SB_* environment variables (for example `sbrs --headless --browser firefox test` sets SB_HEADLESS and SB_BROWSER), so a test that loads `Settings` sees them, and `-n` sets how many tests run at once.
"""#
    flag --test help="Run one integration test file from tests/" {
        arg <NAME>
    }
    flag --example help="Run one example from examples/ instead of the tests" {
        arg <NAME>
    }
    flag --release help="Build with the release profile"
    flag --features help="Cargo features to enable, separated by commas" var=#true {
        arg <FEATURES>
    }
    arg "[FILTER]" help="Run only the tests whose name contains this text" required=#false
    arg "[-- HARNESS_ARGS]…" help="Arguments for the test harness, after `--` (for example --nocapture)" required=#false var=#true
}
cmd grid-hub help="Start, stop, restart or check a Selenium Grid hub" {
    long_help #"""
Start, stop, restart or check a Selenium Grid hub.

Needs a Selenium Server jar you supply; nothing is downloaded. The process record and log are kept in a folder of your own (SB_GRID_DIR).
"""#
    flag --jar help="The Selenium Server jar (default: the SB_SELENIUM_SERVER_JAR variable). It is never downloaded" {
        arg <PATH>
    }
    flag --java help="The Java executable (default: `java` on PATH)" {
        arg <PATH>
    }
    flag --grid-host help="The address to listen on" {
        arg <HOST>
    }
    flag --grid-port help="The port to listen on (default: 4444 for a hub, 5555 for a node)" {
        arg <PORT>
    }
    flag --hub help="For a node, the hub to register with: a host or a URL" {
        arg <HOST_OR_URL>
    }
    flag --session-timeout help="Close sessions that have been idle this many seconds" {
        arg <SECONDS>
    }
    flag --wait help="How many seconds `start` waits for the Grid to become ready" default="60" {
        arg <SECONDS>
    }
    flag --grid-verbose help="Log at INFO instead of WARNING"
    flag --skip-port-check help="Start even if something already accepts connections on the port"
    arg <ACTION> help="What to do with the Grid process" {
        choices start stop restart status
    }
    arg "[-- EXTRA_ARGS]…" help="More arguments for the Selenium Server, after `--`" required=#false var=#true
}
cmd grid-node help="Start, stop, restart or check a Selenium Grid node" {
    long_help #"""
Start, stop, restart or check a Selenium Grid node.

A node registers with the hub named by `--hub`, or with this machine's.
"""#
    flag --jar help="The Selenium Server jar (default: the SB_SELENIUM_SERVER_JAR variable). It is never downloaded" {
        arg <PATH>
    }
    flag --java help="The Java executable (default: `java` on PATH)" {
        arg <PATH>
    }
    flag --grid-host help="The address to listen on" {
        arg <HOST>
    }
    flag --grid-port help="The port to listen on (default: 4444 for a hub, 5555 for a node)" {
        arg <PORT>
    }
    flag --hub help="For a node, the hub to register with: a host or a URL" {
        arg <HOST_OR_URL>
    }
    flag --session-timeout help="Close sessions that have been idle this many seconds" {
        arg <SECONDS>
    }
    flag --wait help="How many seconds `start` waits for the Grid to become ready" default="60" {
        arg <SECONDS>
    }
    flag --grid-verbose help="Log at INFO instead of WARNING"
    flag --skip-port-check help="Start even if something already accepts connections on the port"
    arg <ACTION> help="What to do with the Grid process" {
        choices start stop restart status
    }
    arg "[-- EXTRA_ARGS]…" help="More arguments for the Selenium Server, after `--`" required=#false var=#true
}
cmd translate help="Write the actions of a JSON scenario in another language" {
    long_help #"""
Write the actions of a JSON scenario in another language.

Rewrites each step's `action` (`click`, `open`, ...) with the translation dictionary and changes nothing else in the file; the steps keep running, because a scenario can be read in any of the languages. Python SeleniumBase translates Python test files; a Rust test is compiled code, so this translates the portable JSON scenario instead.
"""#
    flag "-p --print" help="Print the translation and write nothing (the default)"
    flag "-o --overwrite" help="Replace the file with the translation"
    flag "-c --copy" help="Write the translation to a new file next to it, such as `login_es.json`"
    arg <FILE> help="The scenario file"
    arg <LANGUAGE> help="The language: a code (en, zh, nl, fr, it, ja, ko, pt, ru, es) or its English name"
}
cmd mkdir help="Create a folder with a runnable browser-test suite" {
    long_help #"""
Create a folder with a runnable browser-test suite.

Names are relative to the current directory and use letters, digits, `_`, `-` and `.`, with `/` between folders. Nothing is overwritten unless `--force` is given.
"""#
    flag "-b --basic" help="Create only the scaffolding, with no example tests"
    flag --force help="Replace generated files that already exist"
    arg <DIR> help="Folder to create, for example `tests/ui`"
}
cmd mkfile help="Create a browser-test file" {
    alias new
    long_help #"""
Create a browser-test file.

The name follows the same rules as `mkdir`; `.rs` is added when missing. An existing file is never overwritten unless `--force` is given.
"""#
    flag --url help="Page the test opens (default: https://example.com)" {
        arg <URL>
    }
    flag "-b --basic" help="Leave the test body empty: it only opens the page"
    flag --force help="Replace the file if it already exists"
    arg <FILE> help="File to create, for example `tests/login.rs`"
}
cmd commander help="Launch the interactive commander (needs a build with the `tui` feature)"
cmd caseplans help="Launch the Case Plans Generator, a terminal app (needs a build with the `tui` feature)" {
    alias case-plans
    long_help #"""
Launch the Case Plans Generator, a terminal app (needs a build with the `tui` feature).

Lists the tests under PATH and creates, edits and saves a case plan for each, `case_plans/<test>.md` next to its file, and writes a summary of the plans to `case_summary.md`. PATH is a folder of tests or one test file; by default the `tests/` and `examples/` folders of the current folder.

The Python command opens a Tkinter window; this one runs in the terminal.
"""#
    flag --starter help="Write the starter checklist `CASE_PLANS.md` instead; this needs no `tui` feature"
    arg "[PATH]" help="A folder of tests, or one test file" required=#false
}
cmd behave-gui help="Launch the Behave Commander, a terminal app (needs a build with the `tui` feature)" {
    alias gui-behave
    long_help #"""
Launch the Behave Commander, a terminal app (needs a build with the `tui` feature).

Lists the `.feature` files under PATH with their scenarios, runs the ones you mark through the crate's behave runner and shows the results. PATH is a folder of feature files or one file; by default `features`.

The runner has only the built-in steps: steps written in Rust are not loaded, and a scenario that uses one is reported as undefined. The Python command opens a Tkinter window; this one runs in the terminal.
"""#
    flag --new help="Prompt for a name, a title and scenarios and write a new feature file instead; this needs no `tui` feature"
    arg "[PATH]" help="A folder of feature files, or one `.feature` file" required=#false
}
cmd print help="Print a file" {
    flag --file help="File path to print" required=#true {
        arg <FILE>
    }
}
cmd objectify help="Objectify a test recording"
cmd mkpres help="Create an HTML presentation" {
    flag --file help="Output HTML presentation path" required=#true {
        arg <FILE>
    }
}
cmd mkchart help="Create an HTML chart" {
    flag --file help="Output HTML chart path" required=#true {
        arg <FILE>
    }
}
cmd mkrec help="Create a test recording scaffold" {
    flag --file help="Output recording scaffold path" required=#true {
        arg <FILE>
    }
}
cmd run-scenario help="Run a scenario file and write an optional dashboard" {
    flag --file help="Scenario file to run" required=#true {
        arg <FILE>
    }
    flag --dashboard help="Optional path to write a scenario dashboard" {
        arg <DASHBOARD>
    }
}
cmd completions help="Generate a completion script for a supported shell, or a Fig spec" {
    arg <SHELL> help="Shell (or `fig` for a Fig spec) to generate completions for" {
        choices bash zsh fish elvish powershell fig usage
    }
}
cmd import-python help="Convert common SeleniumBase or Selenium Python code into a Rust test" {
    flag "-o --output" help="Output file for the generated Rust test" {
        arg <OUTPUT>
    }
    flag --source help="Source API to assume when converting Python code" default=auto {
        arg <SOURCE> {
            choices auto selenium-base selenium
        }
    }
    flag --test-name help="Name of the generated test function" {
        arg <TEST_NAME>
    }
    arg <FILE> help="Python source file to convert"
}
cmd import-playwright help="Convert Playwright tests or a script (JavaScript, TypeScript or Python) into Rust tests for the pure CDP engine" {
    alias import-pw
    flag "-o --output" help="Output file for the generated Rust tests" {
        arg <OUTPUT>
    }
    flag --language help="Source language (default: from the file extension, else from the content)" {
        arg <LANGUAGE> {
            choices js ts python
        }
    }
    flag --test-name help="Name of the test generated for a script without test titles (default: the file name)" {
        arg <TEST_NAME>
    }
    arg <FILE> help="Playwright source file to convert"
}
cmd import-puppeteer help="Convert Puppeteer scripts or tests (JavaScript, TypeScript) or a Chrome Recorder JSON export into Rust tests for the pure CDP engine" {
    alias import-pptr
    flag "-o --output" help="Output file for the generated Rust tests" {
        arg <OUTPUT>
    }
    flag --language help="Source language (default: from the file extension, else from the content)" {
        arg <LANGUAGE> {
            choices js ts json
        }
    }
    flag --test-name help="Name of the test generated for a script without test titles (default: the file name)" {
        arg <TEST_NAME>
    }
    arg <FILE> help="Puppeteer source file (or Recorder `.json` export) to convert"
}
cmd download-file help="Download a file from a URL (browser download with an HTTP fallback)" {
    flag "-o --output" help="Output file path (defaults to the URL file name in the current directory)" {
        arg <OUTPUT>
    }
    flag --timeout help="Seconds to wait for the browser download before falling back to HTTP" default="30" {
        arg <TIMEOUT>
    }
    arg <URL> help="URL of the file to download"
}
cmd print-pdf help="Print a page to PDF and save it to disk" {
    flag "-o --output" help="Output PDF file path" default=page.pdf {
        arg <OUTPUT>
    }
    arg <URL> help="URL to render as a PDF"
}
cmd pdf-text help="Print the text extracted from a page or PDF URL" {
    flag --save-pdf help="Also keep the intermediate PDF at this path" {
        arg <SAVE_PDF>
    }
    arg <URL> help="URL of the page or PDF to extract text from"
}
cmd assert-pdf-text help="Assert that a page or PDF URL contains the expected text" {
    flag --text help="Text that must appear in the PDF" required=#true {
        arg <TEXT>
    }
    flag --save-pdf help="Also keep the intermediate PDF at this path" {
        arg <SAVE_PDF>
    }
    arg <URL> help="URL of the page or PDF to check"
}
cmd choose-file help="Upload a local file into a file input" {
    flag --url help="Page to open first (defaults to a generated blank upload page)" {
        arg <URL>
    }
    arg <SELECTOR> help="CSS selector of the <input type=file> element"
    arg <FILE> help="Local file to upload"
}
cmd deferred help="Run several assertions, then report every failure at once" {
    flag --url help="URL to open before running the assertions" {
        arg <URL>
    }
    flag --assert help="Assertion spec: element=<css>, text=<css>:<text>, title=<text>, or url=<text>" var=#true {
        arg <SPEC>
    }
    flag --spec help="JSON file containing an array of assertion specs" {
        arg <SPEC>
    }
}
cmd record help="Record browser interactions into a replayable action file" {
    flag "-o --output" help="Output action file (.json or .yaml)" default=actions.json {
        arg <OUTPUT>
    }
    flag --duration help="Stop recording after this many seconds (default: run until Ctrl-C)" {
        arg <DURATION>
    }
    arg <URL> help="URL to open and record"
}
cmd replay help="Replay a recorded action file against a fresh browser session" {
    arg <FILE> help="JSON action file produced by `sbrs record`"
}

