    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs --url https://example.com click-partial-link-text --text 'More info'"
}
cmd human-type help_heading="Page commands" help="Type text with human-like timing and noise." {
    flag --css help="CSS selector for the target element" required=#true {
        arg <CSS>
