flag --webdriver help="WebDriver server URL (default: SB_WEBDRIVER_URL, else http://localhost:4444)" global=#true {
    arg <URL>
}
flag --browser help="Browser engine to launch (SB_BROWSER; default: chrome, or the config file's)" global=#true {
    arg <BROWSER> {
        choices {
            choice chrome
            choice chromium
            choice edge
            choice firefox
            choice brave help="Brave, run with chromedriver."
            choice comet help="Perplexity's Comet, run with chromedriver."
            choice opera help="Opera, run with operadriver."
            choice safari help="Safari, run with safaridriver (macOS)."
            choice ie help="Internet Explorer, run with IEDriverServer (Windows)."
            choice cft help="Chrome for Testing, downloaded when missing."
            choice chs help="chrome-headless-shell, downloaded when missing."
        }
    }
}
flag --headed help="Run the browser in headed mode (SB_HEADLESS=false)" global=#true bool_value=#true {
    alias --gui hide=#true
}
flag --headless help="Run the browser in headless mode (SB_HEADLESS)" global=#true bool_value=#true {
    alias --headless2 hide=#true
}
flag --cdp help="Enable Chrome DevTools Protocol mode (SB_MODE=cdp)" global=#true bool_value=#true
flag --uc help="Enable undetected-chromedriver style evasions (SB_MODE=uc)" global=#true bool_value=#true {
    alias --undetected --undetectable hide=#true
}
flag --user-agent help="Override the default user agent string (SB_USER_AGENT)" global=#true {
    arg <USER_AGENT>
}
flag "-a --agent" help="Alias for --user-agent (SB_USER_AGENT)" global=#true {
    arg <AGENT>
}
flag --locale help="Locale string for the browser context (SB_LOCALE)" global=#true {
    arg <LOCALE>
}
flag "--start-page --url --start_page" help="Page the browser opens first, Python's --start-page (SB_START_PAGE; aliases --url and --start_page)" global=#true {
    long_help #"""
Page the browser opens first, Python's --start-page (SB_START_PAGE; aliases --url and --start_page)

Every command starts its own browser and closes it at the end, so a command that acts on a page (get-text, click, screenshot, assert-element, ...) acts on this one: `sbrs --url https://example.com get-text --css p`. A bare host gets `https://` and a local file becomes a `file://` URL. The command line wins over SB_START_PAGE, which wins over the `start_page` key of the settings file. Commands that open a URL of their own (open, smoke, download-file, print-pdf, pdf-text, assert-pdf-text, record) refuse it.
"""#
    arg <URL>
}
flag "--save-screenshot --save_screenshot" help="Save a screenshot to latest_logs/ just before the browser closes, and print its path (SB_SAVE_SCREENSHOT)" global=#true bool_value=#true {
    long_help #"""
Save a screenshot to latest_logs/ just before the browser closes, and print its path (SB_SAVE_SCREENSHOT)

Python's `--save-screenshot`. A command that acts on the page (click, type, ...) also prints where it ended up as `Now at: <url> (<title>)`.
"""#
}
flag --ad-block help="Refuse the requests of ad and tracker hosts (SB_AD_BLOCK; Chromium WebDriver sessions)" global=#true bool_value=#true {
    alias --adblock --block-ads hide=#true
}
flag --proxy help="Proxy (SB_PROXY; host:port or scheme://host:port); with --proxy-list, a name from the list" global=#true {
    alias --proxy-server --proxy-string hide=#true
    arg <PROXY>
}
flag --proxy-list help="File of proxies to choose from; without --proxy a random one is used (SB_PROXY_LIST)" global=#true {
    arg <FILE>
}
flag --proxy-pac-url help="URL to a proxy auto-config (PAC) file (SB_PROXY_PAC_URL)" global=#true {
    alias --pac-url hide=#true
    arg <PROXY_PAC_URL>
}
flag --user-data-dir help="Path to a persistent browser user-data directory (SB_USER_DATA_DIR)" global=#true {
    arg <USER_DATA_DIR>
}
flag --extension-dir help="Path to an unpacked extension directory (SB_EXTENSION_DIR)" global=#true {
    arg <EXTENSION_DIR>
}
flag "--reuse-session --reuse_session --rs" help="Share browsers among the tests of the run (SB_REUSE_SESSION)" global=#true bool_value=#true
flag "--rcs --reuse-class-session --reuse_class_session" help="Share a browser among the tests of one Rust module (SB_REUSE_CLASS_SESSION)" global=#true bool_value=#true
flag --mobile help="Use a mobile device emulation profile (SB_MOBILE)" global=#true bool_value=#true {
    alias --mobile-emulator hide=#true
}
flag "--esc-end --esc_end --ee" help="End the current test when ESC is pressed in the browser (SB_ESC_END)" global=#true bool_value=#true
flag "--rec-sb-cdp --rec_sb_cdp" help="Write recordings as pure CDP code (SB_REC_SB_CDP; sb_cdp Page and Locator calls)" global=#true bool_value=#true
flag "-c --config" help="Path to a TOML/JSON settings file (SB_SETTINGS_FILE)" global=#true {
    alias --settings-file --settings hide=#true
    arg <CONFIG>
}
flag --fingerprint help="Make every browser the command starts present the fingerprint in FILE (SB_FINGERPRINT)" global=#true {
    long_help #"""
Make every browser the command starts present the fingerprint in FILE (SB_FINGERPRINT)

The file is the fingerprint JSON that `sbrs fingerprint capture` and `export` write. A Chromium browser then runs in the CDP mode unless --uc or another mode is given. The command line wins over SB_FINGERPRINT, which wins over the [fingerprint] table of the settings file. The user agent, language and proxy named by their own options win over the fingerprint's.
"""#
    arg <FILE>
}
flag --plugin help="Turn on a built-in plugin in the browsers the command starts (SB_PLUGINS; repeatable)" global=#true var=#true {
    long_help #"""
Turn on a built-in plugin in the browsers the command starts (SB_PLUGINS; repeatable)

Adds to the plugins the settings file (the [plugins] table) and SB_PLUGINS turn on. Precedence, highest first: the command line, then SB_PLUGINS (which replaces the names the file enables), then the settings file. `sbrs plugin list` shows the plugins this build has. `sbrs test` passes the names on to the tests as SB_PLUGINS.
"""#
    arg <NAME>
}
flag --plugin-opt help="Set one option of a plugin, NAME.KEY=VALUE with a TOML VALUE (repeatable)" global=#true var=#true {
    long_help #"""
Set one option of a plugin, NAME.KEY=VALUE with a TOML VALUE (repeatable)

Quote the whole option so the shell keeps the quotes of a string: --plugin-opt 'shield.level="strict"'. An option given here replaces the same option from SB_PLUGINS or the settings file and keeps the plugin's other options, so the precedence is the command line, then SB_PLUGINS, then the file. The plugin must be turned on by --plugin, SB_PLUGINS or the file. Not available for `sbrs test`: put the options in the [plugins.NAME] table of the settings file.
"""#
    arg "<NAME.KEY=VALUE>"
}
