cmd install help_heading="Drivers, grid and servers" help="Download a driver into ./downloaded_drivers/ (Python's `sbrs get`)." {
    alias get
    long_help #"""
Download a driver into ./downloaded_drivers/ (Python's `sbrs get`).

Without a version, chromedriver and edgedriver are the drivers for the installed Chrome and Edge, and geckodriver is the newest release.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[DRIVER]" help="The driver: chromedriver, geckodriver (or firefoxdriver), edgedriver (or msedgedriver)." default=chromedriver
    arg "[VERSION]" help="`latest`, a major version (chromedriver, edgedriver), a full build, or a geckodriver version such as 0.36.0."
    example "sbrs install chromedriver latest"
}
cmd test help_heading=Tests help="Run the project's tests, or one example, through Cargo." {
    long_help #"""
Run the project's tests, or one example, through Cargo.

The global options reach the tests as SB_* environment variables (for example `sbrs --headless --browser firefox test` sets SB_HEADLESS and SB_BROWSER), so a test that loads `Settings` sees them, and `-n` sets how many tests run at once. `--plugin` reaches them as SB_PLUGINS, with the plugins the settings file and the variable already turn on; `--plugin-opt` cannot be passed on, so `sbrs test` refuses it.
"""#
    flag --test help="Run one integration test file from tests/." conflicts=--example {
        arg <NAME>
    }
    flag --example help="Run one example from examples/ instead of the tests." {
        arg <NAME>
    }
    flag --release help="Build with the release profile." bool_value=#true
    flag --features help="Cargo features to enable, separated by commas." var=#true delimiter=, {
        arg <FEATURES>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[FILTER]" help="Run only the tests whose name contains this text." conflicts=--example
    arg "[HARNESS_ARGS]..." help="Arguments for the test harness, after `--` (for example --nocapture)." double_dash=required
    example "sbrs test login"
}
cmd grid-hub help_heading="Drivers, grid and servers" help="Start, stop, restart or check a Selenium Grid hub." args_override_self=#false {
    long_help #"""
Start, stop, restart or check a Selenium Grid hub.

Needs a Selenium Server jar you supply; nothing is downloaded. The process record and log are kept in a folder of your own (SB_GRID_DIR).
"""#
    flag --jar help="The Selenium Server jar (default: the SB_SELENIUM_SERVER_JAR variable). It is never downloaded." {
        arg <PATH>
    }
    flag --java help="The Java executable (default: `java` on PATH)." {
        arg <PATH>
    }
    flag --grid-host help="The address to listen on." {
        arg <HOST>
    }
    flag --grid-port help="The port to listen on (default: 4444 for a hub, 5555 for a node)." {
        arg <PORT>
    }
    flag --hub help="For a node, the hub to register with: a host or a URL." {
        arg <HOST_OR_URL>
    }
    flag --session-timeout help="Close sessions that have been idle this many seconds." {
        arg <SECONDS>
    }
    flag --wait help="How many seconds `start` waits for the Grid to become ready." default="60" {
        arg <SECONDS>
    }
    flag --grid-verbose help="Log at INFO instead of WARNING." bool_value=#true
    flag --skip-port-check help="Start even if something already accepts connections on the port." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ACTION> help="What to do with the Grid process." {
        choices {
            choice start help="Start it and wait until it is ready."
            choice stop help="Stop it."
            choice restart help="Stop it if it is running, then start it."
            choice status help="Say whether it is running and ready."
        }
    }
    arg "[EXTRA_ARGS]..." help="More arguments for the Selenium Server, after `--`." double_dash=required
    complete path type=path
    example "sbrs grid-hub start"
}
cmd grid-node help_heading="Drivers, grid and servers" help="Start, stop, restart or check a Selenium Grid node." args_override_self=#false {
    long_help #"""
Start, stop, restart or check a Selenium Grid node.

A node registers with the hub named by `--hub`, or with this machine's.
"""#
    flag --jar help="The Selenium Server jar (default: the SB_SELENIUM_SERVER_JAR variable). It is never downloaded." {
        arg <PATH>
    }
    flag --java help="The Java executable (default: `java` on PATH)." {
        arg <PATH>
    }
    flag --grid-host help="The address to listen on." {
        arg <HOST>
    }
    flag --grid-port help="The port to listen on (default: 4444 for a hub, 5555 for a node)." {
        arg <PORT>
    }
    flag --hub help="For a node, the hub to register with: a host or a URL." {
        arg <HOST_OR_URL>
    }
    flag --session-timeout help="Close sessions that have been idle this many seconds." {
        arg <SECONDS>
    }
    flag --wait help="How many seconds `start` waits for the Grid to become ready." default="60" {
        arg <SECONDS>
    }
    flag --grid-verbose help="Log at INFO instead of WARNING." bool_value=#true
    flag --skip-port-check help="Start even if something already accepts connections on the port." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ACTION> help="What to do with the Grid process." {
        choices {
            choice start help="Start it and wait until it is ready."
            choice stop help="Stop it."
            choice restart help="Stop it if it is running, then start it."
            choice status help="Say whether it is running and ready."
        }
    }
    arg "[EXTRA_ARGS]..." help="More arguments for the Selenium Server, after `--`." double_dash=required
    complete path type=path
    example "sbrs grid-node start"
}
cmd translate help_heading="Files and generators" help="Write the actions of a JSON scenario in another language." {
    long_help #"""
Write the actions of a JSON scenario in another language.

Rewrites each step's `action` (`click`, `open`, ...) with the translation dictionary and changes nothing else in the file; the steps keep running, because a scenario can be read in any of the languages. Python SeleniumBase translates Python test files; a Rust test is compiled code, so this translates the portable JSON scenario instead.
"""#
    flag "-p --print" help="Print the translation and write nothing (the default)." bool_value=#true {
        conflicts --overwrite --copy
    }
    flag "-o --overwrite" help="Replace the file with the translation." conflicts=--copy bool_value=#true
    flag "-c --copy" help="Write the translation to a new file next to it, such as `login_es.json`." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="The scenario file."
    arg <LANGUAGE> help="The language: a code (en, zh, nl, fr, it, ja, ko, pt, ru, es) or its English name."
    complete file type=path
    example "sbrs translate scenario.json zh --print"
}
cmd mkdir help_heading="Files and generators" help="Create a folder with a runnable browser-test suite." {
    long_help #"""
Create a folder with a runnable browser-test suite.

Names are relative to the current directory and use letters, digits, `_`, `-` and `.`, with `/` between folders. Nothing is overwritten unless `--force` is given.
"""#
    flag "-b --basic" help="Create only the scaffolding, with no example tests." bool_value=#true
    flag --force help="Replace generated files that already exist." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <DIR> help="Folder to create, for example `tests/ui`."
    example "sbrs mkdir ui_tests"
}
cmd mkfile help_heading="Files and generators" help="Create a browser-test file." {
    alias new
    long_help #"""
Create a browser-test file.

The name follows the same rules as `mkdir`; `.rs` is added when missing. An existing file is never overwritten unless `--force` is given.
"""#
    flag --url help="Page the test opens (default: https://example.com)." {
        arg <URL>
    }
    flag "-b --basic" help="Leave the test body empty: it only opens the page." bool_value=#true
    flag --force help="Replace the file if it already exists." bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="File to create, for example `tests/login.rs`."
    example "sbrs mkfile tests/login.rs"
}
cmd commander help_heading=Tests help="Launch the interactive commander (needs a build with the `tui` feature)." {
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs commander"
}
cmd caseplans help_heading=Tests help="Launch the Case Plans Generator, a terminal app (needs a build with the `tui` feature)." {
    alias case-plans
    long_help #"""
Launch the Case Plans Generator, a terminal app (needs a build with the `tui` feature).

Lists the tests under PATH and creates, edits and saves a case plan for each, `case_plans/<test>.md` next to its file, and writes a summary of the plans to `case_summary.md`. PATH is a folder of tests or one test file; by default the `tests/` and `examples/` folders of the current folder.

The Python command opens a Tkinter window; this one runs in the terminal.
"""#
    flag --starter help="Write the starter checklist `CASE_PLANS.md` instead; this needs no `tui` feature." conflicts=PATH bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATH]" help="A folder of tests, or one test file."
    example "sbrs caseplans --starter"
}
cmd behave-gui help_heading=Tests help="Launch the Behave Commander, a terminal app (needs a build with the `tui` feature)." {
    alias gui-behave
    long_help #"""
Launch the Behave Commander, a terminal app (needs a build with the `tui` feature).

Lists the `.feature` files under PATH with their scenarios, runs the ones you mark through the crate's behave runner and shows the results. PATH is a folder of feature files or one file; by default `features`.

The runner has only the built-in steps: steps written in Rust are not loaded, and a scenario that uses one is reported as undefined. The Python command opens a Tkinter window; this one runs in the terminal.
"""#
    flag --new help="Prompt for a name, a title and scenarios and write a new feature file instead; this needs no `tui` feature." conflicts=PATH bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATH]" help="A folder of feature files, or one `.feature` file."
    example "sbrs behave-gui features"
}
cmd print help_heading="Files and generators" help="Print a file." {
    flag --file help="File path to print" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs print --file tests/login.rs"
}
cmd objectify help_heading="Files and generators" help="Objectify a test recording." {
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs objectify"
}
cmd mkpres help_heading="Files and generators" help="Create an HTML presentation." {
    flag --file help="Output HTML presentation path" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs mkpres --file deck.html"
}
cmd mkchart help_heading="Files and generators" help="Create an HTML chart." {
    flag --file help="Output HTML chart path" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs mkchart --file chart.html"
}
cmd mkrec help_heading="Record and replay" help="Create a test recording scaffold, or record a test live with --url." {
    flag --url help="Open this page in a browser and record what you do there into the file" {
        arg <URL>
    }
    flag --duration help="With --url: stop recording after this many seconds (default: until Ctrl-C)" {
        arg <DURATION>
    }
    flag --file help="Output recording scaffold path" required=#true {
        arg <FILE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs mkrec --url https://example.com --file tests/recorded.rs --duration 60"
}
cmd run-scenario help_heading=Tests help="Run a scenario file, the way to do several steps in one browser, and write an optional dashboard." {
    flag --file help="Scenario file to run" required=#true {
        arg <FILE>
    }
    flag --dashboard help="Optional path to write a scenario dashboard" {
        arg <DASHBOARD>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs run-scenario --file scenario.json"
}
cmd completions help_heading="Info and setup" help="Generate a completion script for a supported shell, or a Fig spec." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SHELL> help="Shell (or `fig` for a Fig spec) to generate completions for" {
        choices {
            choice bash
            choice zsh
            choice fish
            choice elvish
            choice powershell
            choice fig help="A Fig completion spec (TypeScript), the format of the withfig/autocomplete repository that Warp's built-in completions, inshellisense and Amazon Q use."
            choice usage help="A usage spec (KDL) for jdx/usage and mise, which turn it into completions, Markdown and man pages."
        }
    }
    example "sbrs completions zsh"
}
cmd import-python help_heading="Import and convert" help="Convert common SeleniumBase or Selenium Python code into a Rust test." {
    flag "-o --output" help="Output file for the generated Rust test" {
        arg <OUTPUT>
    }
    flag --source help="Source API to assume when converting Python code" default=auto {
        arg <SOURCE> {
            choices {
                choice auto
                choice selenium-base
                choice selenium
            }
        }
    }
    flag --test-name help="Name of the generated test function" {
        arg <TEST_NAME>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Python source file to convert."
    example "sbrs import-python login.py --output tests/login.rs"
}
cmd import-playwright help_heading="Import and convert" help="Convert Playwright tests or a script (JavaScript, TypeScript or Python) into Rust tests for the pure CDP engine." {
    alias import-pw
    flag "-o --output" help="Output file for the generated Rust tests" {
        arg <OUTPUT>
    }
    flag --language help="Source language (default: from the file extension, else from the content)" {
        arg <LANGUAGE> {
            choices {
                choice js help=JavaScript.
                choice ts help=TypeScript.
                choice python help=Python.
            }
        }
    }
    flag --test-name help="Name of the test generated for a script without test titles (default: the file name)" {
        arg <TEST_NAME>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Playwright source file to convert."
    example "sbrs import-playwright login.spec.ts --output tests/login.rs"
}
cmd import-puppeteer help_heading="Import and convert" help="Convert Puppeteer scripts or tests (JavaScript, TypeScript) or a Chrome Recorder JSON export into Rust tests for the pure CDP engine." {
    alias import-pptr
    flag "-o --output" help="Output file for the generated Rust tests" {
        arg <OUTPUT>
    }
    flag --language help="Source language (default: from the file extension, else from the content)" {
        arg <LANGUAGE> {
            choices {
                choice js help=JavaScript.
                choice ts help=TypeScript.
                choice json help="A Chrome DevTools Recorder JSON export."
            }
        }
    }
    flag --test-name help="Name of the test generated for a script without test titles (default: the file name)" {
        arg <TEST_NAME>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="Puppeteer source file (or Recorder `.json` export) to convert."
    example "sbrs import-puppeteer login.js --output tests/login.rs"
}
cmd download-file help_heading="Page commands" help="Download a file from a URL (browser download with an HTTP fallback)." {
    flag "-o --output" help="Output file path (defaults to the URL file name in the current directory)" {
        arg <OUTPUT>
    }
    flag --timeout help="Seconds to wait for the browser download before falling back to HTTP" default="30" {
        arg <TIMEOUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL of the file to download"
    example "sbrs download-file https://example.com/report.pdf --output report.pdf"
}
cmd print-pdf help_heading="Page commands" help="Print a page to PDF and save it to disk." {
    flag "-o --output" help="Output PDF file path" default=page.pdf {
        arg <OUTPUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL to render as a PDF"
    example "sbrs print-pdf https://example.com --output page.pdf"
}
cmd pdf-text help_heading="Page commands" help="Print the text extracted from a page or PDF URL." {
    flag --save-pdf help="Also keep the intermediate PDF at this path" {
        arg <SAVE_PDF>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL of the page or PDF to extract text from"
    example "sbrs pdf-text https://example.com/report.pdf"
}
cmd assert-pdf-text help_heading="Page commands" help="Assert that a page or PDF URL contains the expected text." {
    flag --text help="Text that must appear in the PDF" required=#true {
        arg <TEXT>
    }
    flag --save-pdf help="Also keep the intermediate PDF at this path" {
        arg <SAVE_PDF>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL of the page or PDF to check"
    example "sbrs assert-pdf-text https://example.com/report.pdf --text Total"
}
cmd choose-file help_heading="Page commands" help="Upload a local file into a file input." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SELECTOR> help="CSS selector of the <input type=file> element"
    arg <FILE> help="Local file to upload"
    example "sbrs --url https://example.com/upload choose-file 'input[type=file]' ./photo.png"
}
cmd deferred help_heading="Page commands" help="Run several assertions, then report every failure at once." {
    long_help #"""
Run several assertions, then report every failure at once.

The page they run on is the global --url, if there is one.
"""#
    flag --assert help="Assertion spec: element=<css>, text=<css>:<text>, title=<text>, or url=<text>" var=#true {
        arg <SPEC>
    }
    flag --spec help="JSON file containing an array of assertion specs" {
        arg <SPEC>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs --url https://example.com deferred --assert element=h1 --assert 'text=h1:Example Domain'"
}
cmd record help_heading="Record and replay" help="Record browser interactions into a replayable action file." {
    flag "-o --output" help="Output action file (.json or .yaml)" default=actions.json {
        arg <OUTPUT>
    }
    flag --duration help="Stop recording after this many seconds (default: run until Ctrl-C)" {
        arg <DURATION>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <URL> help="URL to open and record"
    example "sbrs record https://example.com --output actions.json --duration 30"
}
cmd replay help_heading="Record and replay" help="Replay a recorded action file against a fresh browser session." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <FILE> help="JSON action file produced by `sbrs record`"
    example "sbrs replay actions.json"
}
cmd devtools help_heading="Drivers, grid and servers" help="Launch Chrome with an open DevTools endpoint and print MCP client configs." {
    long_help #"""
Launch Chrome with an open DevTools endpoint and print MCP client configs.

Starts Chrome with the Pure CDP engine (no chromedriver), prints the DevTools HTTP endpoint, the browser WebSocket URL and configs for Google's chrome-devtools-mcp and Microsoft's Playwright MCP, then keeps the browser running until Ctrl+C, which closes it and exits with 0. The global --browser (chrome, chromium, edge or another Chromium browser), --headless, --headed, --user-data-dir, --proxy, --user-agent, --locale, --ad-block, --extension-dir --proxy-list and --url (the page to open once the browser runs) apply as well.
"""#
    flag --port help="DevTools port on 127.0.0.1 (0 lets Chrome pick a free one)" default="9222" {
        arg <PORT>
    }
    flag --browser-path help="Browser binary to launch, such as Microsoft Edge or another Chromium browser" {
        arg <PATH>
    }
    flag --json help="Print the endpoint and configs as one line of JSON instead of text" bool_value=#true
    flag "-h --help" help="Print help" action=help builtin=#true
    example "sbrs devtools --port 9222"
}
cmd plugin help_heading="Info and setup" help="List the built-in plugins, or show what one declares." subcommand_required=#true {
    long_help #"""
List the built-in plugins, or show what one declares.

Plugins run inside the browsers a command starts. Turn them on by name with the global options --plugin and --plugin-opt, the SB_PLUGINS variable, or the [plugins] table of the settings file; the command line wins over SB_PLUGINS, which wins over the file. `sbrs plugin list` shows the plugins this build has.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd list help="List the built-in plugins of this build, and whether they are on." {
        long_help #"""
List the built-in plugins of this build, and whether they are on.

Prints each plugin's name, category and summary, and `yes` under ENABLED when the settings file, SB_PLUGINS or the global --plugin option turns it on. A build without built-in plugins says so; rebuild it with --features plugins-builtin.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        example "sbrs plugin list"
    }
    cmd info help="Show what one plugin declares and what it may do." {
        long_help #"""
Show what one plugin declares and what it may do.

Prints the plugin's category, phase, capabilities (with their risk, and whether the host enforces them), what it needs, its place among the other plugins and the options it was given. Exits with status 2 and lists the known names when there is no such plugin.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <NAME> help="The plugin's name, as `sbrs plugin list` shows it."
        example "sbrs plugin info shield"
    }
    example "sbrs plugin list"
}
cmd fingerprint help_heading=Security help="Capture, write, check and compare browser fingerprints." subcommand_required=#true {
    long_help #"""
Capture, write, check and compare browser fingerprints.

A fingerprint file is what a browser claims to be: the user agent, the screen, the language, the graphics card and the rest, as one JSON file. `capture` reads it from a real browser; `export` writes a preset or a random identity; `check` and `diff` read files. The global --fingerprint FILE (or SB_FINGERPRINT, or the [fingerprint] table of the settings file) makes every browser a command starts present one.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd capture help="Read the fingerprint of a real browser and write it as a fingerprint file." args_override_self=#false {
        long_help #"""
Read the fingerprint of a real browser and write it as a fingerprint file.

Starts a browser as `sbrs open` does (the global --browser, --headless, --proxy and the rest apply), opens URL (a blank page when there is none), reads what a page can see of the browser, and prints the fingerprint as JSON, or writes it to FILE. A summary goes to standard error. What no setting holds (window sizes, the automation markers, the canvas hash) stays out of the fingerprint; --readings writes it to its own file.
"""#
        flag "-o --output" help="Write the fingerprint to FILE instead of printing it." {
            arg <FILE>
        }
        flag --readings help="Also write the readings that no setting holds, and where the capture was taken, to FILE." {
            arg <FILE>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        arg "[URL]" help="The page to open first (default: a blank page)."
        complete file type=path
        example "sbrs fingerprint capture https://example.com --output seen.json"
    }
    cmd export help="Write a preset or a random identity as a fingerprint file." args_override_self=#false {
        long_help #"""
Write a preset or a random identity as a fingerprint file.

Give --preset NAME (windows, edge, macos, linux, android, ios) or --random. A random identity follows --seed, so the same seed gives the same file, and --os, the system it claims (default: this machine's). The file goes to FILE, else to standard output.
"""#
        flag --preset help="The preset to write: windows, edge, macos, linux, android or ios (safari is ios)." {
            arg <NAME>
        }
        flag --random help="Write a random identity instead of a preset." bool_value=#true
        flag --seed help="With --random, the seed of the draw: the same seed gives the same identity." {
            arg <N>
        }
        flag --os help="With --random, the system the identity claims (default: this machine's)." {
            arg <OS> {
                choices {
                    choice windows
                    choice macos
                    choice linux
                    choice android
                    choice ios
                }
            }
        }
        flag "-o --output" help="Write the fingerprint to FILE instead of printing it." {
            arg <FILE>
        }
        flag "-h --help" help="Print help" action=help builtin=#true
        complete file type=path
        example "sbrs fingerprint export --preset windows --output windows.json"
    }
    cmd check help="Check that a fingerprint file loads and is coherent." {
        long_help #"""
Check that a fingerprint file loads and is coherent.

Prints how many settings the file gives, each error and warning, and the verdict. Exits with status 2 when there is an error or the file does not load.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <FILE> help="The fingerprint file to check."
        complete file type=path
        example "sbrs fingerprint check windows.json"
    }
    cmd diff help="Compare two fingerprint files." {
        long_help #"""
Compare two fingerprint files.

EXPECTED is what is expected and FOUND what is found: a setting that EXPECTED leaves natural is never compared. Prints each setting that differs. Exits with status 1 when any differs, 0 when none does, and 2 when a file does not load.

To check that a browser presents a file: `sbrs --fingerprint f.json fingerprint capture -o seen.json`, then `sbrs fingerprint diff f.json seen.json`.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <EXPECTED> help="The file with what is expected."
        arg <FOUND> help="The file with what is found."
        complete expected type=path
        complete found type=path
        example "sbrs fingerprint diff windows.json seen.json"
    }
    cmd presets help="List the presets and what each claims." {
        flag "-h --help" help="Print help" action=help builtin=#true
        example "sbrs fingerprint presets"
    }
    example "sbrs fingerprint presets"
}
