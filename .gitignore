/target
/target_check
/target-tui
/.copilot-target
/book
.DS_Store
node_modules/
downloaded_drivers/
# Where a browser launched by the library saves downloads (./downloaded_files)
downloaded_files/
.serena/
# JetBrains IDE (RustRover) project settings
/.idea/
__pycache__/

# What GitLab CI keeps in the project folder for its cache and artifacts: mise's folders
# (MISE_DATA_DIR), cargo's registry/git cache under CARGO_HOME (.cargo/audit.toml stays tracked),
# cargo-audit, release staging/dist archives, and chrome:undetected logs
/.mise/
/.cargo/*
!/.cargo/audit.toml
/.cargo-audit/
/dist/
/stage/
/undetected_logs/

# Left in the project directory by the local docker build wrapper
slim.report.json
.ai-bom.json
.ai-build-context.md
.ai-build-error.json

# check_window baselines written by test runs
visual_baseline/

# Screenshots, page sources and charts the examples and tests save
latest_logs/

# The run the processes of a test session share (sbrs test, the sb fixture)
.sbrs_run/

# The default output folder of sbrs-mcp (SB_MCP_OUTPUT_DIR): screenshots, saved
# pages and the generated HTTP bearer token (mcp-token), which is a secret
mcp_output/
mcp-token

# Snapshots insta has written and nobody has accepted yet (cargo insta review)
*.snap.new
*.pending-snap

