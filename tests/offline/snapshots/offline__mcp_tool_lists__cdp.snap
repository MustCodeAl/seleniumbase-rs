    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Check Condition"
      },
      "description": "Answer true or false right now whether an element is present or visible, or whether some text is visible in it. Does not wait; use wait_for_condition to wait.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "default": "visible",
            "description": "What to check; ignored when text is given",
            "enum": [
              "present",
              "visible"
            ],
            "type": "string"
          },
          "selector": {
            "default": "body",
            "description": "CSS selector, XPath, or link=text",
            "type": "string"
          },
          "text": {
            "description": "Check that this text is visible in the element",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "check_if_condition",
      "untrusted": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Click Element"
      },
      "description": "Click an element. Use nth to pick one of several matches, all_matches to click every visible one, only_if_visible to skip a missing element quietly, or parent_selector to search inside a container.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "all_matches": {
            "default": false,
            "description": "Click every visible match, in page order",
            "type": "boolean"
          },
          "nth": {
            "description": "Which match to click, counting from 1",
            "minimum": 1.0,
            "type": "integer"
          },
          "only_if_visible": {
            "default": false,
            "description": "Click only if the element is already visible; never wait",
            "type": "boolean"
          },
          "parent_selector": {
            "description": "Look for the selector inside this container",
            "type": "string"
          },
          "selector": {
            "description": "CSS selector, XPath, or link=text",
            "type": "string"
          },
          "timeout": {
            "default": 5.0,
            "description": "Seconds to wait for the element",
            "minimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "selector"
        ],
        "type": "object"
      },
      "name": "click_element",
      "untrusted": false
    },
