        "title": "Open URL"
      },
      "description": "Navigate the active tab to a URL and wait for it to load. A bare host such as example.com gets https:// added.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Address to open",
