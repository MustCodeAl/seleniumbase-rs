{
  "server": "seleniumbase-cdp",
  "tool_count": 43,
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Start Browser"
      },
      "description": "Launch the Chrome session the other tools use. Does nothing if one is already running. Headless by default on Linux, headed elsewhere.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "ad_block": {
            "default": false,
            "description": "Block common ad requests",
            "type": "boolean"
          },
          "fingerprint": {
            "description": "A fingerprint to apply to every tab, as a JSON object in the v2 file format; not with fingerprint_path or fingerprint_preset. Applied in undetected mode (uc, the default) on the driver and sb servers; Chromium browsers only",
            "type": "object"
          },
          "fingerprint_path": {
            "description": "Path of a saved fingerprint file to apply (in the output folder or the working directory); not with fingerprint or fingerprint_preset",
            "type": "string"
          },
          "fingerprint_preset": {
            "description": "A built-in fingerprint to apply; not with fingerprint or fingerprint_path",
            "enum": [
              "windows",
              "edge",
              "macos",
              "linux",
              "android",
              "ios"
            ],
            "type": "string"
          },
          "guest": {
            "default": false,
            "description": "Guest profile; cannot be combined with incognito",
            "type": "boolean"
          },
          "headless": {
            "description": "Force headless (true) or headed (false)",
            "type": "boolean"
          },
          "incognito": {
            "default": false,
            "description": "Incognito window",
            "type": "boolean"
          },
          "proxy": {
            "description": "SERVER:PORT or USER:PASS@SERVER:PORT",
            "type": "string"
          },
          "url": {
            "description": "Page to open as the browser starts",
            "type": "string"
          },
          "use_chromium": {
            "default": false,
            "description": "Use Chromium instead of Google Chrome",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "start_browser",
      "untrusted": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Close Browser"
      },
      "description": "Close the browser session and everything in it: tabs, cookies and history. Safe to call when nothing is running.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "close_browser",
      "untrusted": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Get Page Info"
      },
      "description": "Report whether a browser is running and, if so, the active tab's URL, title, origin and user agent.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "get_page_info",
