        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Get DevTools Endpoint"
      },
      "description": "Report the DevTools endpoint of the running browser (HTTP address and browser WebSocket URL) and ready-made MCP client configs that attach Google's chrome-devtools-mcp (--browserUrl) or Microsoft's Playwright MCP (--cdp-endpoint) to the same browser. Reports running=false when no browser runs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "get_devtools_endpoint",
      "untrusted": false
    },
    {
