{
  "server": "seleniumbase-sb",
  "tool_count": 114,
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Start Browser"
      },
      "description": "Start the browser session the other tools use. Does nothing if one is running.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "ad_block": {
            "default": false,
            "description": "Block common ad requests",
            "type": "boolean"
          },
          "browser": {
            "default": "chrome",
            "description": "Which browser",
            "enum": [
              "chrome",
              "edge",
              "firefox",
              "chromium"
            ],
            "type": "string"
          },
          "fingerprint": {
            "description": "A fingerprint to apply to every tab, as a JSON object in the v2 file format; not with fingerprint_path or fingerprint_preset. Applied in undetected mode (uc, the default) on the driver and sb servers; Chromium browsers only",
            "type": "object"
          },
          "fingerprint_path": {
            "description": "Path of a saved fingerprint file to apply (in the output folder or the working directory); not with fingerprint or fingerprint_preset",
            "type": "string"
          },
          "fingerprint_preset": {
            "description": "A built-in fingerprint to apply; not with fingerprint or fingerprint_path",
            "enum": [
              "windows",
              "edge",
              "macos",
              "linux",
              "android",
              "ios"
            ],
            "type": "string"
          },
          "guest_mode": {
            "default": false,
            "description": "Guest profile; cannot be combined with incognito",
            "type": "boolean"
          },
          "headless": {
            "description": "Force headless (true) or headed (false); default is headless on Linux only",
            "type": "boolean"
          },
          "incognito": {
            "default": false,
            "description": "Incognito window",
            "type": "boolean"
          },
          "proxy": {
            "description": "SERVER:PORT or USER:PASS@SERVER:PORT",
            "type": "string"
          },
          "uc": {
            "default": true,
            "description": "Undetected mode, for sites with bot detection (Chrome and Chromium only)",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "start_browser",
      "untrusted": false
    },
