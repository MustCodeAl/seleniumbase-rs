    },
    {
      "annotations": {
        "title": "Get Console Messages"
      },
      "description": "Read the page's console messages and uncaught script errors. Messages are recorded from the moment start is true, which replaces the page's console functions (a page script can notice that); the Pure CDP engine also reports uncaught errors since the page loaded without it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "clear": {
            "default": false,
            "description": "Forget the messages after reading them",
            "type": "boolean"
          },
          "level": {
            "default": "all",
            "description": "The least serious level to include",
            "enum": [
              "all",
              "error",
              "warning",
              "info",
              "log"
            ],
            "type": "string"
          },
          "limit": {
            "default": 100,
            "description": "Most messages to return, 1 to 500",
            "minimum": 1.0,
            "type": "integer"
          },
          "start": {
            "default": false,
            "description": "Start recording console messages in this page",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "get_console_messages",
      "untrusted": true
    },
    {
      "annotations": {
        "title": "Get Failed Requests"
      },
      "description": "List the page's requests that failed: HTTP status 400 and up from the browser's performance timeline, and, once watch is true on the Pure CDP engine, every failed, blocked or refused request of the active tab with its error.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "clear": {
            "default": false,
            "description": "Forget the recorded failures after reading them",
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "description": "Most requests to return, 1 to 500",
            "minimum": 1.0,
            "type": "integer"
          },
          "watch": {
            "default": false,
            "description": "Start recording failed requests (Pure CDP engine)",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "get_failed_requests",
      "untrusted": false
    },
    {
