    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Page Snapshot"
      },
      "description": "Read the page as a compact accessibility tree: landmarks, headings, links, buttons and form controls with their roles, names, state and values. Interactive nodes carry a ref such as [ref=e5]; pass \"ref=e5\" as the selector of click_element, type_text and the other tools. Call it again after the page changes: refs belong to the last snapshot. mode \"outline\" shows the tag tree instead, for pages with poor semantics. Passwords and card numbers are never printed.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "default": 12,
            "description": "Deepest nesting to list, 1 to 30",
            "minimum": 1.0,
            "type": "integer"
          },
          "include_hidden": {
            "default": false,
            "description": "Also list nodes that are not visible",
            "type": "boolean"
          },
          "max_nodes": {
            "default": 400,
            "description": "Most nodes to list, 1 to 2000",
            "minimum": 1.0,
            "type": "integer"
          },
          "mode": {
            "default": "accessibility",
            "description": "The accessibility tree, or the DOM tag tree",
            "enum": [
              "accessibility",
              "outline"
            ],
            "type": "string"
          },
          "scope": {
            "description": "Only look inside the first element this selector (or ref=eN) matches",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "page_snapshot",
      "outputSchema": {
        "properties": {
          "mode": {
            "enum": [
              "accessibility",
              "outline"
            ],
            "type": "string"
          },
          "more": {
            "minimum": 0,
            "type": "integer"
          },
          "nodes": {
            "description": "The nodes that have refs.",
            "items": {
              "properties": {
                "checked": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "frame": {
                  "type": "null"
                },
                "name": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "shadow": {
                  "type": "boolean"
                },
                "value": {
                  "type": "string"
                },
                "visible": {
                  "type": "boolean"
                }
              },
              "required": [
                "ref",
                "role",
                "name",
                "selector",
                "visible",
                "enabled",
                "frame"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "snapshot": {
            "minimum": 1,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "snapshot",
          "truncated",
          "nodes"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Read Page Text"
      },
      "description": "Read the readable text of the page as Markdown: the main content (main, article, or the densest block), headings as #, links as [text](url), lists and tables. Scripts, styles and hidden nodes are skipped. Cut at max_chars on a block boundary and says how much more there was.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "default": "markdown",
            "description": "Markdown, or plain text",
            "enum": [
              "markdown",
              "text"
            ],
            "type": "string"
          },
          "main_only": {
            "default": true,
            "description": "Only the main content, without navigation and footers",
            "type": "boolean"
          },
          "max_chars": {
            "default": 20000,
            "description": "Most characters to return, 1000 to 200000",
            "minimum": 1000.0,
            "type": "integer"
          },
          "scope": {
            "description": "Only look inside the first element this selector (or ref=eN) matches",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "read_page_text",
      "outputSchema": {
        "properties": {
          "chars": {
            "minimum": 0,
            "type": "integer"
          },
          "format": {
            "enum": [
              "markdown",
              "text"
            ],
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "total_chars": {
            "minimum": 0,
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "source",
          "format",
          "chars",
          "total_chars",
          "truncated"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Extract Links"
      },
      "description": "List the visible links of the page with their text, absolute URL, rel, target and the landmark they sit in. Duplicates are collapsed with a count; javascript: links are flagged. The first 100 links carry a ref.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "contains": {
            "description": "Only links whose text or URL contains this, in any case",
            "type": "string"
          },
          "limit": {
            "default": 200,
            "description": "Most links to return, 1 to 2000",
            "minimum": 1.0,
            "type": "integer"
          },
          "same_origin": {
            "default": false,
            "description": "Only links to the page's own origin",
            "type": "boolean"
          },
          "scope": {
            "description": "Only look inside the first element this selector (or ref=eN) matches",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "extract_links",
      "outputSchema": {
        "properties": {
          "links": {
            "items": {
              "properties": {
                "count": {
                  "minimum": 2,
                  "type": "integer"
                },
                "href": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "script"
                  ],
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "rel": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text",
                "href",
                "region"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "links",
          "total",
          "truncated"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Extract Tables"
      },
      "description": "Read the visible tables (HTML tables and role=table or grid) as data: caption, headers and rows, with colspan and rowspan expanded. Each table also carries a selector and a ref.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 20,
            "description": "Most tables to return, 1 to 100",
            "minimum": 1.0,
            "type": "integer"
          },
          "max_rows": {
            "default": 200,
            "description": "Most rows per table, 1 to 5000",
            "minimum": 1.0,
            "type": "integer"
          },
          "scope": {
            "description": "Only look inside the first element this selector (or ref=eN) matches",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "extract_tables",
      "outputSchema": {
        "properties": {
          "more_tables": {
            "minimum": 0,
            "type": "integer"
          },
          "tables": {
            "items": {
              "properties": {
                "caption": {
                  "type": "string"
                },
                "headers": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "ref": {
                  "type": "string"
                },
                "row_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "rows": {
                  "items": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                "selector": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "headers",
                "rows",
                "row_count",
                "truncated"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "tables"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Extract Forms"
      },
      "description": "Read the forms of the page as data: action, method and each field with its name, type, label, required flag, value, checked state and options, plus the submit button. Fields and forms carry refs. Password and card values are left out.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "description": "Only look inside the first element this selector (or ref=eN) matches",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "extract_forms",
      "outputSchema": {
        "properties": {
          "forms": {
            "items": {
              "properties": {
                "action": {
                  "type": "string"
                },
                "fields": {
                  "items": {
                    "properties": {
                      "checked": {
                        "type": "boolean"
                      },
                      "label": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "options": {
                        "items": {
                          "properties": {
                            "label": {
                              "type": "string"
                            },
                            "selected": {
                              "type": "boolean"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "value",
                            "label",
                            "selected"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "ref": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "type": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "type",
                      "label",
                      "required"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "method": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "submit": {
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "ref": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "action",
                "method",
                "fields"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "more_forms": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "forms"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "title": "Capture Fingerprint"
      },
      "description": "Read what the running browser shows a page, as a fingerprint: the navigator, Client Hints, screen, time zone, WebGL, media devices and more, plus readings no setting holds (webdriver flag, plugins, canvas and audio hashes, headless markers). Optionally opens url first and saves the fingerprint as a file. An https page or about:blank gives the whole fingerprint; an http page has no Client Hints or media devices.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "save_to": {
            "description": "File name in the output folder to save the fingerprint to, as JSON; the file is private to its owner",
            "type": "string"
          },
          "url": {
            "description": "Page to open before reading",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "capture_fingerprint",
      "outputSchema": {
        "properties": {
          "fingerprint": {
            "description": "The v2 fingerprint file",
            "type": "object"
          },
          "probe": {
            "properties": {
              "browser_version": {
                "type": "string"
              },
              "captured_at": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "captured_at"
            ],
            "type": "object"
          },
          "saved": {
            "type": "string"
          },
          "settings_read": {
            "type": "integer"
          },
          "unmapped": {
            "description": "Readings no setting holds",
            "type": "object"
          }
        },
        "required": [
          "fingerprint",
          "unmapped",
          "probe",
          "settings_read"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Compare Fingerprint"
      },
      "description": "Ask whether the running browser presents a fingerprint (give a fingerprint, a path or a preset): captures what the page shows and lists the settings it contradicts, the ones it matches and the ones no page can read (those are never counted as matches). The text starts with presents: yes|no, verified: yes|no.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "description": "A fingerprint as a JSON object, in the v2 file format (a string holding the JSON is accepted too)",
            "type": "object"
          },
          "path": {
            "description": "Path of a saved fingerprint file in the output folder, relative to that folder",
            "type": "string"
          },
          "preset": {
            "description": "A built-in fingerprint preset",
            "enum": [
              "windows",
              "edge",
              "macos",
              "linux",
              "android",
              "ios"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "compare_fingerprint",
      "outputSchema": {
        "properties": {
          "claimed": {
            "type": "integer"
          },
          "differences": {
            "items": {
              "properties": {
                "setting": {
                  "type": "string"
                }
              },
              "required": [
                "setting",
                "expected",
                "actual"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "matched": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "presents": {
            "type": "boolean"
          },
          "unverifiable": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "presents",
          "verified",
          "claimed",
          "differences",
          "matched",
          "unverifiable"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "title": "Explain Fingerprint"
      },
      "description": "Say what a detection script would find in the running browser: the signs of automation (webdriver flag, headless markers, software renderer ...) with how loudly a detector reacts and what to change, whether the readings agree with each other, and the values a script reads first. Optionally opens url first.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Page to open before reading",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "explain_fingerprint",
      "outputSchema": {
        "properties": {
          "coherence": {
            "type": "object"
          },
          "detector_view": {
            "type": "object"
          },
          "leaks": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "not_readable": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "risk": {
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "unanswered": {
            "type": "object"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "risk",
          "leaks",
          "coherence",
          "detector_view",
          "not_readable"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Diff Fingerprints"
      },
      "description": "Compare two fingerprints: a is what is expected and b what is found, so a setting a leaves natural is not compared. Each is a preset name, a file path or the fingerprint as JSON text. Lists every setting that differs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "a": {
            "description": "The expected fingerprint: a preset name, the path of a fingerprint file (output folder or working directory), or the fingerprint as JSON text (a JSON object is accepted too)",
            "type": "string"
          },
          "b": {
            "description": "The fingerprint found: a preset name, the path of a fingerprint file (output folder or working directory), or the fingerprint as JSON text (a JSON object is accepted too)",
            "type": "string"
          }
        },
        "required": [
          "a",
          "b"
        ],
        "type": "object"
      },
      "name": "diff_fingerprints",
      "outputSchema": {
        "properties": {
          "compared": {
            "type": "integer"
          },
          "differences": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "identical": {
            "type": "boolean"
          }
        },
        "required": [
          "identical",
          "compared",
          "differences"
        ],
        "type": "object"
      },
      "untrusted": false
    },
    {
      "annotations": {
        "title": "Patch Fingerprint"
      },
      "description": "Change a fingerprint (not the chromedriver patcher): apply a JSON merge patch (RFC 7386) to the v2 file format of a fingerprint, a path or a preset. A null removes a setting, which leaves it to the browser. The result is parsed and checked for contradictions; a patch that makes it unreadable is refused with the setting at fault. Optionally saves a valid result.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "description": "A fingerprint as a JSON object, in the v2 file format (a string holding the JSON is accepted too)",
            "type": "object"
          },
          "patch": {
            "description": "The merge patch, for example {\"timezone\": \"Asia/Tokyo\"}",
            "type": "object"
          },
          "path": {
            "description": "Path of a saved fingerprint file in the output folder, relative to that folder",
            "type": "string"
          },
          "preset": {
            "description": "A built-in fingerprint preset",
            "enum": [
              "windows",
              "edge",
              "macos",
              "linux",
              "android",
              "ios"
            ],
            "type": "string"
          },
          "save_to": {
            "description": "File name in the output folder to save the fingerprint to, as JSON; the file is private to its owner",
            "type": "string"
          }
        },
        "required": [
          "patch"
        ],
        "type": "object"
      },
      "name": "patch_fingerprint",
      "outputSchema": {
        "properties": {
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "object"
          },
          "saved": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "fingerprint",
          "valid",
          "errors",
          "warnings"
        ],
        "type": "object"
      },
      "untrusted": false
    }
  ]
}
