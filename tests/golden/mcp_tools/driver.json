        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Page Snapshot"
      },
      "description": "Read the page as a compact accessibility tree: landmarks, headings, links, buttons and form controls with their roles, names, state and values. Interactive nodes carry a ref such as [ref=e5]; pass \"ref=e5\" as the selector of click_element, type_text and the other tools. Call it again after the page changes: refs belong to the last snapshot. mode \"outline\" shows the tag tree instead, for pages with poor semantics. Passwords and card numbers are never printed.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "default": 12,
            "description": "Deepest nesting to list, 1 to 30",
            "minimum": 1.0,
            "type": "integer"
          },
          "include_hidden": {
            "default": false,
            "description": "Also list nodes that are not visible",
            "type": "boolean"
          },
          "max_nodes": {
            "default": 400,
            "description": "Most nodes to list, 1 to 2000",
            "minimum": 1.0,
            "type": "integer"
          },
          "mode": {
            "default": "accessibility",
            "description": "The accessibility tree, or the DOM tag tree",
            "enum": [
              "accessibility",
              "outline"
            ],
            "type": "string"
          },
          "scope": {
            "description": "Only look inside the first element this selector (or ref=eN) matches",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "page_snapshot",
      "outputSchema": {
        "properties": {
          "mode": {
            "enum": [
              "accessibility",
              "outline"
            ],
            "type": "string"
          },
          "more": {
            "minimum": 0,
            "type": "integer"
          },
          "nodes": {
            "description": "The nodes that have refs.",
            "items": {
              "properties": {
                "checked": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "frame": {
                  "type": "null"
                },
                "name": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "shadow": {
                  "type": "boolean"
                },
                "value": {
                  "type": "string"
                },
                "visible": {
                  "type": "boolean"
