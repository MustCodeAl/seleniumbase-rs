            "type": "array"
          },
          "snapshot": {
            "minimum": 1,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "snapshot",
          "truncated",
          "nodes"
        ],
        "type": "object"
      },
      "untrusted": true
    },
    {
