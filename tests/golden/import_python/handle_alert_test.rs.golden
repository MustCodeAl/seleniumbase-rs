//! Converted from Python by `sbrs import-python`. Run it with `cargo test --test handle_alert_test`
//! when this file is in your crate's `tests/` folder; `SB_HEADLESS=true` runs it
//! without a window. Search for `TODO` to find what was not converted.

use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn handle_alert_test(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.goto("about:blank").await?;
        sb.execute_script("window.alert(\"ALERT!!!\");").await?;
        sb.sleep(1.0).await; // Not needed (Lets you see the alert pop up)
        let alert_present = sb.is_alert_present().await?;
        sb.assert_true(alert_present)?;
        sb.accept_alert().await?;
        sb.sleep(1.0).await; // Not needed (Lets you see the alert go away)
        sb.execute_script("window.prompt(\"My Prompt\",\"defaultText\");").await?;
        sb.sleep(1.0).await; // Not needed (Lets you see the alert pop up)
        let alert = sb.switch_to_alert().await?;
        let text = alert.text().await?;
        sb.assert_equal(text.as_str(), "My Prompt")?; // Not input field
        sb.dismiss_alert().await?;
        sb.sleep(1.0).await; // Not needed (Lets you see the alert go away)
        let alert_present_2 = sb.is_alert_present().await?;
        sb.assert_false(alert_present_2)?;
        // TODO(source line 20): `self.browser` has no Rust equal
        //     self.browser == "safari" and self._reuse_session
        if false {
            // Alerts can freeze Safari if reusing the browser session
            // TODO(source line 22): `self.driver` has no Rust equal
            //     self.driver.quit()
        }
        Ok(())
    })
    .await
}
