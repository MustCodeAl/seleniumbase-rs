//! Converted from Python by `sbrs import-python`. Run it with `cargo test --test test_tinymce`
//! when this file is in your crate's `tests/` folder; `SB_HEADLESS=true` runs it
//! without a window. Search for `TODO` to find what was not converted.

use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn test_tinymce(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        // TODO(source line 7): `self.headless` has no Rust equal
        //     self.headless
        if false {
            sb.goto_if_not_url("about:blank").await?;
            sb.skip_test("Skip this test in headless mode!")?;
        }
        sb.goto("https://seleniumbase.io/tinymce/").await?;
        sb.wait_for_element("div.mce-container-body").await?;
        sb.click("span:contains(\"File\")").await?;
        sb.click("span:contains(\"New document\")").await?;
        sb.click("span:contains(\"Paragraph\")").await?;
        sb.click("span:contains(\"Heading 2\")").await?;
        sb.switch_to_frame("iframe").await?;
        sb.add_text("#tinymce", "Automate anything with SeleniumBase!\n").await?;
        sb.switch_to_parent_frame().await?;
        sb.click("button i.mce-i-image").await?;
        sb.type_text("input[aria-label=\"Width\"].mce-textbox", "300").await?;
        let image_url = "https://seleniumbase.github.io/img/sb_logo_10.png";
        sb.type_text("input.mce-textbox", &format!("{}\n", image_url)).await?;
        sb.frame_switch("iframe")
            .run(async |sb| {
                sb.click("h2").await?;
                sb.post_message("Automate anything with SeleniumBase!").await?;
                Ok(())
            })
            .await?;
        sb.click("span:contains(\"File\")").await?;
        sb.click("span:contains(\"Preview\")").await?;
        sb.switch_to_frame("iframe[sandbox=\"allow-scripts\"]").await?;
        sb.post_message("Learn SeleniumBase Today!").await?;
        Ok(())
    })
    .await
}
