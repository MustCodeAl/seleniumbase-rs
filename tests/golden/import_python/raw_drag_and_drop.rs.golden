//! Converted from Python by `sbrs import-python`. Run it with `cargo test --test raw_drag_and_drop`
//! when this file is in your crate's `tests/` folder; `SB_HEADLESS=true` runs it
//! without a window. Search for `TODO` to find what was not converted.

use seleniumbase_rs::sb_cdp::{Scroll};
use seleniumbase_rs::testing::{rstest, sb_cdp, SbCdp};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn raw_drag_and_drop_1(sb_cdp: SbCdp) -> Result<()> {
    sb_cdp
        .run(async |page| {
            // SB(uc=True, test=True, incognito=True, fast=True): the browser settings come from the SB_* variables and the settings file
            page.goto("https://seleniumbase.io/other/drag_and_drop").await?;
            page.locator("#div1 img#drag1").expect().not().to_be_visible().await?;
            page.locator("#drag1").drag_to(&page.locator("#div1")).await?;
            page.locator("#div1 img#drag1").expect().to_be_visible().await?;
            tokio::time::sleep(std::time::Duration::from_secs_f64(1.0)).await;
            Ok(())
        })
        .await
}

