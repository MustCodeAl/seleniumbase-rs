use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn test_cycle_elements(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.goto("seleniumbase.io/demo_page").await?;
        sb.assert_text("This Text is Green", "#pText").await?;
        sb.add_text("html", "\t\t\t\t\n").await?;
        sb.assert_text("This Text is Purple", "#pText").await?;
        Ok(())
    })
    .await
}
