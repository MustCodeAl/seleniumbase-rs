use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn test_highlight_elements(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.goto("https://seleniumbase.io/demo_page").await?;
        // TODO(source line 8): `self.headed` has no Rust equal
        //     self.headed
        if false {
            sb.highlight_elements("input").loops(2).await?; // Default: 4
        } else {
            sb.highlight_elements("input").loops(1).limit(3).await?;
        }
        Ok(())
    })
    .await
}
