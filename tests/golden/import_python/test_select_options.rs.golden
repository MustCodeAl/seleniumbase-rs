//! Converted from Python by `sbrs import-python`. Run it with `cargo test --test test_select_options`
//! when this file is in your crate's `tests/` folder; `SB_HEADLESS=true` runs it
//! without a window. A comment marks each statement it could not convert.

use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn test_select_options(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.goto("https://seleniumbase.io/demo_page").await?;
        let expected_option_texts = ["Set to 25%", "Set to 50%", "Set to 75%", "Set to 100%"].map(String::from).to_vec();
        let option_texts = sb.get_select_options("select#mySelect").await?;
        sb.assert_equal(&option_texts, &expected_option_texts)?;
        let expected_option_indexes = ["0", "1", "2", "3"].map(String::from).to_vec();
        let option_indexes = sb.get_select_options("select#mySelect").attribute("index").await?;
        sb.assert_equal(&option_indexes, &expected_option_indexes)?;
        let expected_option_values = ["25%", "50%", "75%", "100%"].map(String::from).to_vec();
        let option_values = sb.get_select_options("select#mySelect").attribute("value").await?;
        sb.assert_equal(&option_values, &expected_option_values)?;
        for (index, option_text) in option_texts.iter().enumerate() {
            sb.select_option_by_text("#mySelect", option_text).await?;
            let selected_value = sb.get_attribute("#mySelect", "value").await?.unwrap_or_default();
            sb.assert_equal(selected_value.as_str(), option_values[index].as_str())?;
        }
        for (index, option_value) in option_values.iter().enumerate() {
            sb.select_option_by_value("#mySelect", option_value).await?;
            let selected_value = sb.get_attribute("#mySelect", "value").await?.unwrap_or_default();
            sb.assert_equal(selected_value.as_str(), option_values[index].as_str())?;
        }
        for (index, option_index) in option_indexes.iter().enumerate() {
            sb.select_option_by_index("#mySelect", option_index.parse().expect("a whole number")).await?;
            // assert_attribute() combines get_attribute() and assert_equal()
            // It also highlights the element when Demo Mode is enabled.
            sb.assert_attribute("#mySelect", "value", &option_values[index]).await?;
        }
        Ok(())
    })
    .await
}
