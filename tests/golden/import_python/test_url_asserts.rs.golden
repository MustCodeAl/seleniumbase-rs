//! Converted from Python by `sbrs import-python`. Run it with `cargo test --test test_url_asserts`
//! when this file is in your crate's `tests/` folder; `SB_HEADLESS=true` runs it
//! without a window. A comment marks each statement it could not convert.

use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn test_url_asserts(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.goto("https://seleniumbase.io/help_docs/how_it_works/").await?;
        sb.assert_url("https://seleniumbase.io/help_docs/how_it_works/").await?;
        sb.assert_title_contains("How it Works").await?;
        sb.js_click("nav a:contains(\"Coffee Cart\")").await?;
        sb.assert_url_contains("/coffee").await?;
        sb.assert_title("Coffee Cart").await?;
        Ok(())
    })
    .await
}
