//! Browser test generated by `sbase mkfile`.
//!
//! Run it with `cargo test --test url_demo` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver; `sbase doctor`
//! checks both.

use seleniumbase_rs::{run_browser_test, BrowserConfig, Result};

#[tokio::test]
async fn url_demo() -> Result<()> {
    run_browser_test(BrowserConfig::default(), |sb| {
        Box::pin(async move {
            sb.open("https://example.org/app").await?;
            sb.assert_element("body").await
        })
    })
    .await
}
