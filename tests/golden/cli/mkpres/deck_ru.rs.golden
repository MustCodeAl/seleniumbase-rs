//! Тест презентации, созданный `sbrs mkpres`.
//!
//! Run it with `cargo test --test deck_ru` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver (`sbrs doctor`
//! checks both). The deck opens in the browser (saved as
//! `saved_presentations/deck_ru.html`) and plays until its last slide, or until
//! you close the window. With `SB_HEADLESS=true` nobody watches, so nothing is
//! shown or saved.
//!
//! Your crate's only dev-dependency is `seleniumbase-rs` (feature `testing`): the
//! rstest attribute, the fixtures and the Tokio runtime come from it.

use seleniumbase_rs::api::presentation::{PresentationTheme, Transition};
use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn deck_ru(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.create_presentation()
            .theme(PresentationTheme::Serif)
            .transition(Transition::Slide)
            .await?;
        sb.add_slide("<h1>Привет</h1><hr /><br /><p>Нажмите стрелку вправо</p>")
            .await?;
        sb.add_slide("<h2><b>*</b>  Добавить Текст  <b>*</b></h2>")
            .image("https://seleniumbase.github.io/cdn/gif/chart_pres.gif")
            .await?;
        sb.add_slide("<h2>До свидания</h2>")
            .image("https://seleniumbase.github.io/cdn/img/sb_logo_10.png")
            .await?;
        sb.begin_presentation().filename("deck_ru.html").await?;
        Ok(())
    })
    .await
}
