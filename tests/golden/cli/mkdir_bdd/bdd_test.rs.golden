//! A Gherkin scenario: `features/example.feature` says what happens, and the
//! steps are the library's built-in ones. Needs the feature `bdd` of
//! `seleniumbase-rs`.

use seleniumbase_rs::testing::bdd::{sb, scenario, SbCase};
use seleniumbase_rs::testing::rstest;
use seleniumbase_rs::tokio;

#[scenario(
    path = "tests/golden/cli/mkdir_bdd/features/example.feature",
    name = "Open a page"
)]
#[tokio::test(flavor = "multi_thread")]
async fn open_a_page(#[future(awt)] sb: SbCase) {
    let _ = &sb;
}
