//! The first example test. Copy it to start your own.

use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn my_first_test(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.open("https://example.com").await?;
        sb.assert_title("Example Domain").await?;
        sb.assert_text("This domain is for use in", "p").await
    })
    .await
}
