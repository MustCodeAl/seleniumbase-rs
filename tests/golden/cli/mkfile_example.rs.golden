//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test example` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver; `sbrs doctor`
//! checks both.

use seleniumbase_rs::{run_browser_test, BrowserConfig, Result};

#[tokio::test]
async fn example() -> Result<()> {
    run_browser_test(BrowserConfig::default(), async |sb| {
        sb.open("https://example.com").await?;
        sb.assert_title("Example Domain").await?;
        sb.assert_text("h1", "Example Domain").await
    })
    .await
}
