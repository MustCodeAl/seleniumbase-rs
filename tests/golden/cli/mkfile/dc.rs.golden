//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test dc` when this file is in your crate's
//! `tests/` folder. It needs Chrome, which it drives directly (`sbrs doctor`
//! checks it). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's only dev-dependency is `seleniumbase-rs` (feature `testing`): the
//! rstest attribute, the fixtures and the Tokio runtime come from it.

use seleniumbase_rs::testing::{rstest, sb_cdp, SbCdp};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn dc(sb_cdp: SbCdp) -> Result<()> {
    sb_cdp
        .run(async |page| {
            page.goto("https://example.com").await?;
            page.locator("p")
                .expect()
                .to_contain_text("This domain is for use in")
                .await?;
            Ok(())
        })
        .await
}
