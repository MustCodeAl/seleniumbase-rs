//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test dc` when this file is in your crate's
//! `tests/` folder. It needs Chrome, which it drives directly (`sbrs doctor`
//! checks it). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's dev-dependencies are `seleniumbase-rs` (feature `testing`),
//! `rstest` and `tokio` (features `macros` and `rt`).

use rstest::rstest;
use seleniumbase_rs::testing::{sb_cdp, SbCdp};
use seleniumbase_rs::Result;

#[rstest]
#[tokio::test]
async fn dc(sb_cdp: SbCdp) -> Result<()> {
    sb_cdp
        .run(async |page| {
            page.goto("https://example.com").await?;
            page.locator("h1")
                .expect()
                .to_contain_text("Example Domain")
                .await?;
            Ok(())
        })
        .await
}
