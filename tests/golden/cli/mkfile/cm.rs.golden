//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test cm` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver (`sbrs doctor`
//! checks both). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's dev-dependencies are `seleniumbase-rs` and `tokio` (features
//! `macros` and `rt`).

use seleniumbase_rs::config::settings::Settings;
use seleniumbase_rs::{run_browser_test, Result};

#[tokio::test]
async fn cm() -> Result<()> {
    run_browser_test(Settings::load()?.to_browser_config(), async |sb| {
        sb.open("https://example.com").await?;
        sb.assert_title("Example Domain").await?;
        sb.assert_text("This domain is for use in", "p").await?;
        Ok(())
    })
    .await
}
