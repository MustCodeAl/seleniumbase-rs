//! 由 `sbrs mkfile` 生成的浏览器测试。
//!
//! Run it with `cargo test --test pf_zh` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver (`sbrs doctor`
//! checks both). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's dev-dependencies are `seleniumbase-rs` (feature `testing`),
//! `rstest` and `tokio` (features `macros` and `rt`).

use rstest::rstest;
use seleniumbase_rs::testing::{sb, Sb};
use seleniumbase_rs::Result;

#[rstest]
#[tokio::test]
async fn pf_zh(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.open("data:text/html,<meta charset='utf-8'><p>你好<br><input>")
            .await?;
        sb.type_text("input", "再见").await?;
        sb.click("html body > p").await?;
        sb.assert_element("body").await?;
        sb.assert_text("你好", "p").await?;
        Ok(())
    })
    .await
}
