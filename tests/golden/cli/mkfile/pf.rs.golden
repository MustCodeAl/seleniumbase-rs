//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test pf` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver (`sbrs doctor`
//! checks both). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's dev-dependencies are `seleniumbase-rs` (feature `testing`),
//! `rstest` and `tokio` (features `macros` and `rt`).

use rstest::rstest;
use seleniumbase_rs::testing::{sb, Sb};
use seleniumbase_rs::Result;

#[rstest]
#[tokio::test]
async fn pf(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.open("https://example.com").await?;
        sb.assert_title("Example Domain").await?;
        sb.assert_text("Example Domain", "h1").await?;
        Ok(())
    })
    .await
}
