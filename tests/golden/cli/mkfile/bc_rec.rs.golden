//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test bc_rec` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver (`sbrs doctor`
//! checks both). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's only dev-dependency is `seleniumbase-rs`; the Tokio runtime comes
//! from it (`use seleniumbase_rs::tokio;`).
//!
//! It pauses at `recorder_breakpoint` in Recorder Mode, where you click through
//! the page by hand. Run it with `SB_RECORDER=true cargo test --test bc_rec --
//! --nocapture`; the recorded steps are written to `recordings/`.

use seleniumbase_rs::api::recorder::recorder_breakpoint;
use seleniumbase_rs::config::settings::Settings;
use seleniumbase_rs::{tokio, BaseCase, Result};

#[tokio::test]
async fn bc_rec() -> Result<()> {
    let mut sb = BaseCase::new(Settings::load()?.to_browser_config()).await?;
    let outcome = steps(&mut sb).await;
    // Close the browser whether the steps passed or failed.
    sb.quit().await?;
    outcome
}

async fn steps(sb: &mut BaseCase) -> Result<()> {
    sb.open("https://example.com").await?;
    recorder_breakpoint(sb, "Click what you want to test, then press c here").await?;
    Ok(())
}
