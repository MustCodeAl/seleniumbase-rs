//! Browser test generated by `sbrs mkfile`.
//!
//! Run it with `cargo test --test pf_rec` when this file is in your crate's
//! `tests/` folder. It needs Chrome and a matching chromedriver (`sbrs doctor`
//! checks both). `SB_HEADLESS=true` runs it without a window.
//!
//! Your crate's only dev-dependency is `seleniumbase-rs` (feature `testing`): the
//! rstest attribute, the fixtures and the Tokio runtime come from it.
//!
//! It pauses at `recorder_breakpoint` in Recorder Mode, where you click through
//! the page by hand. Run it with `SB_RECORDER=true cargo test --test pf_rec --
//! --nocapture`; the recorded steps are written to `recordings/`.

use seleniumbase_rs::api::recorder::recorder_breakpoint;
use seleniumbase_rs::testing::{rstest, sb, Sb};
use seleniumbase_rs::{tokio, Result};

#[rstest]
#[tokio::test]
async fn pf_rec(sb: Sb) -> Result<()> {
    sb.run(async |sb| {
        sb.open("https://example.com").await?;
        recorder_breakpoint(sb, "Click what you want to test, then press c here").await?;
        Ok(())
    })
    .await
}
