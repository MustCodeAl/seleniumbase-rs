<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="12">
<title>SeleniumBase Dashboard 📊</title>
<style>:root{color-scheme:light dark;--bg:#fff;--fg:#1b1f23;--muted:#6a737d;--line:#d8dee4;--pass:#1a7f37;--fail:#cf222e;--skip:#9a6700;--total:#575792;--pass-bg:#e6f4ea;--fail-bg:#fdecee;--skip-bg:#fff8e5}@media(prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--muted:#8b949e;--line:#30363d;--pass:#3fb950;--fail:#ff7b72;--skip:#d29922;--total:#a5a5ff;--pass-bg:#12261a;--fail-bg:#2d1618;--skip-bg:#2a2412}}body{font:15px/1.5 system-ui,sans-serif;margin:0 auto;max-width:72rem;padding:1rem;background:var(--bg);color:var(--fg)}h1{font-size:1.4rem;margin:0 0 .5rem}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.summary{margin:0 0 .5rem;padding:.5rem .75rem;border-left:4px solid var(--muted);font-weight:600}.summary.pass{border-color:var(--pass);background:var(--pass-bg)}.summary.fail{border-color:var(--fail);background:var(--fail-bg)}.run-count{margin:0 0 1rem;color:var(--muted)}.pie{margin:0 auto 1rem;text-align:center;color:var(--fg)}.pie svg{width:100%;max-width:30rem;height:auto}.pie text{fill:currentColor;font:14px system-ui,sans-serif}.pie .pie-title{font-size:16px;font-weight:600}.pie path,.pie circle{stroke:var(--bg);stroke-width:1.5}.pie circle.empty{fill:none;stroke:var(--muted);stroke-dasharray:4 4}table{border-collapse:collapse;width:100%}table.counts{width:auto;margin:0 auto 1rem}table.counts th{text-align:center;white-space:nowrap}th.c-fail{color:var(--fail)}th.c-skip{color:var(--skip)}th.c-pass{color:var(--pass)}th.c-total{color:var(--total)}th.c-unreported{border-left:4px solid #c9c9c9}th,td{border:1px solid var(--line);padding:.35rem .6rem;text-align:left;vertical-align:top}th{color:var(--muted);font-weight:600}td.num{text-align:right;white-space:nowrap}td.links{white-space:nowrap}.scroll{overflow-x:auto}td.test{min-width:10rem;overflow-wrap:break-word}td.msg{min-width:16rem;white-space:pre-wrap;overflow-wrap:anywhere}td.msg .kind{font:600 12px/1.6 ui-monospace,monospace;color:var(--muted)}td.msg .error{font-weight:600}td.msg .hint,td.msg .page,td.msg .evidence{margin-top:.25rem}td.msg details{margin-top:.35rem;color:var(--muted)}td.msg pre{margin:.25rem 0 0;white-space:pre-wrap;font:12px/1.5 ui-monospace,monospace}td.status{font-weight:700;white-space:nowrap}tr.pass{background:var(--pass-bg)}tr.skip{background:var(--skip-bg)}tr.fail,tr.unreported{background:var(--fail-bg)}tr.pass td.status{color:var(--pass)}tr.fail td.status,tr.unreported td.status{color:var(--fail)}tr.skip td.status{color:var(--skip)}tr.untested td.status{color:var(--muted)}tr.unreported td.status{border-left:4px solid #c9c9c9}.updated,.status-line,.generated{margin:.75rem 0 0}.status-line.pass{color:var(--pass)}.status-line.fail{color:var(--fail)}@media(max-width:40rem){body{padding:.5rem}th,td{padding:.25rem .4rem}}</style>
</head>
<body>
<h1 class="sr-only">SeleniumBase Dashboard 📊</h1>
